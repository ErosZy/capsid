  "deferred_modules": {
    "capsid:path": {
      "reason": "resolve() and relative() implicitly read tjs.cwd; exposing the complete txiki.js API would restore ambient host state",
      "required_design": "a capability-scoped virtual working directory without globalThis.tjs"
    },
    "capsid:net": {
      "reason": "the upstream POSIX socket client bypasses Capsid's hostname and resolved-address egress hook and would permit arbitrary application protocols",
      "required_design": "a brokered client that checks the hostname and every resolved address before connect, with bounded streams and cancellation"
    },
    "capsid:websocket": {
      "reason": "the upstream WebSocket client has no restricted resolved-address egress hook and its long-lived callbacks have no request owner",
      "required_design": "a client-only implementation with DNS and redirect revalidation, bounded queues, cancellation, and explicit request ownership"
    },
    "capsid:sqlite": {
      "reason": "the upstream API accepts ambient file paths and can load extension code; the benchmark-only fixed database is not a product capability",
      "required_design": "an in-memory or path-authorized database with extension loading disabled, an SQL authorizer, memory/row/time quotas, and worker-local ownership"
    },
    "capsid:readline": {
      "reason": "readline depends on terminal stdin, which is deliberately unavailable inside request workers",
      "required_design": "host-provided input over a bounded request-scoped API rather than terminal or process fd access"
    }
  },
  "deferred_operations": {
    "capsid:fs.write": {
      "reason": "write access would require reopening the current seccomp and read-only Landlock boundary",
      "required_design": "write-specific Landlock roots, atomic no-symlink creation, byte quotas, and mutation audit before any write syscall is enabled"
    },
    "capsid:fs.watch": {
      "reason": "persistent callbacks can fire outside the creating request and leak cross-request state",
      "required_design": "request ownership, cancellation on request end, bounded watcher counts and event queues, and symlink-safe watched roots"
    }
  },
  "permissions": {
    "net": {
