cmake_minimum_required(VERSION 3.20)
foreach(required CAPSID_SOURCE_DIR CAPSID_BUILD_DIR CAPSID_WORK_DIR
        CAPSID_C_COMPILER CAPSID_CXX_COMPILER CAPSID_SMOKE_GENERATOR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "package consumer controls require ${required}")
    endif()
endforeach()
if(NOT DEFINED CAPSID_SMOKE_BUILD_TYPE)
    message(FATAL_ERROR "package consumer controls require defined CAPSID_SMOKE_BUILD_TYPE")
endif()

file(STRINGS "${CAPSID_BUILD_DIR}/CPackConfig.cmake" config
    REGEX "^set\\(CPACK_PACKAGE_FILE_NAME ")
if(NOT config MATCHES "^set\\(CPACK_PACKAGE_FILE_NAME \"([^\"]+)\"\\)$")
    message(FATAL_ERROR "cannot identify this build's package archive")
endif()
set(basename "${CMAKE_MATCH_1}")
file(GLOB archives "${CAPSID_BUILD_DIR}/${basename}.tar.gz" "${CAPSID_BUILD_DIR}/${basename}.zip")
list(LENGTH archives count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "package consumer controls require exactly one current archive")
endif()
list(GET archives 0 archive)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(run "${CAPSID_WORK_DIR}/run-${id}")
file(MAKE_DIRECTORY "${run}/source")
file(COPY "${CAPSID_SOURCE_DIR}/tests/package_consumer/" DESTINATION "${run}/source")
file(COPY "${CAPSID_SOURCE_DIR}/tests/package_smoke_sample.c"
    "${CAPSID_SOURCE_DIR}/tests/package_smoke_sample.cc" DESTINATION "${run}/source")
set(cases baseline missing-config wrong-version)
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${run}/baseline prefix")
set(baseline "${run}/baseline prefix/${basename}")
include("${CAPSID_SOURCE_DIR}/cmake/ValidatePackageMetadata.cmake")
capsid_validate_package_metadata("${baseline}" "${CAPSID_SOURCE_DIR}" "${basename}")
capsid_read_build_info_header("${baseline}" header)
foreach(line IN LISTS header)
    if(line MATCHES "^version=(.+)$")
        set(version "${CMAKE_MATCH_1}")
    endif()
endforeach()
if(WIN32 AND CAPSID_PACKAGE_ASAN_RUNTIME)
    list(APPEND cases missing-runtime modified-runtime missing-sanitizer-options)
endif()
set(case_index 0)
foreach(case IN LISTS cases)
    math(EXPR case_index "${case_index} + 1")
    if(case STREQUAL "baseline")
        set(prefix "${baseline}")
    else()
        set(prefix "${run}/p${case_index} prefix/${basename}")
        file(COPY "${baseline}/" DESTINATION "${prefix}")
    endif()
    set(expected "")
    if(case STREQUAL "missing-config")
        file(RENAME "${prefix}/lib/cmake/Capsid/CapsidConfig.cmake"
            "${prefix}/lib/cmake/Capsid/CapsidConfig.cmake.retained")
        set(expected "CapsidConfig.cmake")
    elseif(case STREQUAL "wrong-version")
        file(WRITE "${prefix}/lib/cmake/Capsid/CapsidConfigVersion.cmake"
            "set(PACKAGE_VERSION 0.0.0)\nset(PACKAGE_VERSION_COMPATIBLE FALSE)\n")
        set(expected "version: 0.0.0")
    elseif(case STREQUAL "missing-runtime")
        file(RENAME "${prefix}/bin/${CAPSID_PACKAGE_ASAN_RUNTIME}"
            "${prefix}/bin/${CAPSID_PACKAGE_ASAN_RUNTIME}.retained")
        set(expected "${CAPSID_PACKAGE_ASAN_RUNTIME}")
    elseif(case STREQUAL "modified-runtime")
        file(APPEND "${prefix}/bin/${CAPSID_PACKAGE_ASAN_RUNTIME}" "controlled checksum change")
        set(expected "Capsid ASan runtime checksum differs")
    elseif(case STREQUAL "missing-sanitizer-options")
        set(targets "${prefix}/lib/cmake/Capsid/CapsidTargets.cmake")
        file(READ "${targets}" original)
        string(FIND "${original}" "/fsanitize=address" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "positive MSVC ASan package lacks exported sanitizer options")
        endif()
        string(REPLACE "/fsanitize=address" "" changed "${original}")
        file(WRITE "${targets}" "${changed}")
    endif()
    set(build "${run}/b${case_index}")
    set(command "${CMAKE_COMMAND}" -S "${run}/source" -B "${build}" -G "${CAPSID_SMOKE_GENERATOR}"
        "-DCMAKE_C_COMPILER=${CAPSID_C_COMPILER}" "-DCMAKE_CXX_COMPILER=${CAPSID_CXX_COMPILER}"
        "-DCMAKE_PREFIX_PATH=${prefix}" "-DCMAKE_BUILD_TYPE=${CAPSID_SMOKE_BUILD_TYPE}"
        "-DCAPSID_EXPECTED_VERSION=${version}" -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF
        -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF)
    if(CAPSID_SMOKE_MAKE_PROGRAM)
        list(APPEND command "-DCMAKE_MAKE_PROGRAM=${CAPSID_SMOKE_MAKE_PROGRAM}")
    endif()
    if(WIN32)
        list(APPEND command "-DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded$<$<CONFIG:Debug>:Debug>")
    endif()
    # Preserve native tool bytes. Decoding localized linker output a second
    # time can corrupt adjacent ASCII mismatch keys such as annotate_vector.
    execute_process(COMMAND ${command} ENCODING NONE
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(WRITE "${run}/${case}-configure.log" "${out}${err}")
    if(expected)
        string(FIND "${out}${err}" "${expected}" found)
        if(result EQUAL 0 OR found EQUAL -1)
            message(FATAL_ERROR "consumer control ${case} did not reject the controlled input; ${run}")
        endif()
    else()
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "consumer control ${case} could not configure; ${run}")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}"
                --config "${CAPSID_SMOKE_BUILD_TYPE}" --parallel 2 --verbose
            ENCODING NONE RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        file(WRITE "${run}/${case}-build.log" "${out}${err}")
        if(case STREQUAL "missing-sanitizer-options")
            # Actual MSVC STL annotation mismatch from the C++ sample.
            if(result EQUAL 0 OR NOT "${out}${err}" MATCHES "LNK2038" OR
                    NOT "${out}${err}" MATCHES "annotate_(string|vector)")
                message(FATAL_ERROR "consumer omitted sanitizer options without the expected link failure; ${run}")
            endif()
        elseif(NOT result EQUAL 0)
            message(FATAL_ERROR "positive consumer did not build; ${run}")
        endif()
    endif()
    message(STATUS "PASS: actual package consumer control ${case}")
endforeach()
