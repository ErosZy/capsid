+import { transformPromiseWith, uponPromise } from './helpers/webidl';
+// Capsid's pinned workerd default-profile byte-stream operations.
+// The native fetch adapter retains its separate byte-oriented close protocol.
+const ByteArray = Uint8Array;
+const setBytes = Function.prototype.call.bind(Uint8Array.prototype.set);
+export const weakHas = Function.prototype.call.bind(WeakSet.prototype.has);
+const weakAdd = Function.prototype.call.bind(WeakSet.prototype.add);
+export const mapGet = Function.prototype.call.bind(WeakMap.prototype.get);
+export const mapSet = Function.prototype.call.bind(WeakMap.prototype.set);
+const nativeControllers = new WeakSet<object>();
+const nativeStreams = new WeakSet<object>();
+const nativePipeTransformReadables = new WeakSet<object>();
+export const nativeBranchControllers = new WeakSet<object>();
+const originalContents = new WeakMap<object, Uint8Array>();
+let internalError: ((detail: string) => Error) | undefined;
+let aliasBuffer: ((buffer: ArrayBuffer) => ArrayBuffer) | undefined;
+type StreamPromiseObserver = <T>(promise: Promise<T>) => Promise<T>;
+let nativePromiseObserver: StreamPromiseObserver | undefined;
+
+export function configureByteStreamCompatibility(factory: (detail: string) => Error, bufferAlias: (buffer: ArrayBuffer) => ArrayBuffer, streamObserver?: StreamPromiseObserver): void {
+  if (typeof factory !== 'function' || typeof bufferAlias !== 'function' || (streamObserver !== undefined && typeof streamObserver !== 'function') || internalError !== undefined) throw new TypeError('Byte-stream profile is already configured or invalid');
+  internalError = factory;
+  aliasBuffer = bufferAlias;
+  nativePromiseObserver = streamObserver;
+}
+export function markNativeByteStream<T>(stream: T, branch = false): T {
+  const controller = (stream as any)?._readableStreamController;
+  if (controller && typeof controller === 'object') {
+    weakAdd(nativeControllers, controller);
+    weakAdd(nativeStreams, stream as object);
+    if (branch) weakAdd(nativeBranchControllers, controller);
+  }
+  return stream;
+}
+export function isNativePipeSource(stream: object): boolean {
+  return internalError !== undefined && (weakHas(nativeStreams, stream) || weakHas(nativePipeTransformReadables, stream));
+}
+export function markNativePipeTransformReadable(readable: object): void {
+  weakAdd(nativePipeTransformReadables, readable);
+}
+export function observePrivateNativePipePromise<T>(promise: Promise<T>, native: boolean): Promise<T> {
+  return native && nativePromiseObserver !== undefined ? nativePromiseObserver(promise) : promise;
+}
+export function observeNativeTransformWait<T>(readable: object, promise: Promise<T>): Promise<T> {
+  return observePrivateNativePipePromise(promise, weakHas(nativePipeTransformReadables, readable));
+}
+export function usesWorkerdByteProfile(controller: object): boolean {
+  return internalError !== undefined && !weakHas(nativeControllers, controller);
+}
+export function capturePendingContents(controller: any, buffer: ArrayBuffer, offset: number,
+  length: number, elementSize: number, minimumFill: number): Uint8Array | undefined {
+  if (!usesWorkerdByteProfile(controller) || elementSize <= 1 || minimumFill <= elementSize ||
+      controller._closeRequested || controller._queueTotalSize >= minimumFill) return undefined;
+  const copy = new ByteArray(length);
+  setBytes(copy, new ByteArray(buffer, offset, length));
+  return copy;
+}
+export function rememberPendingContents(descriptor: object, bytes: Uint8Array | undefined): void {
+  if (bytes !== undefined) mapSet(originalContents, descriptor, bytes);
+}
+export function prepareCancelledDescriptor(descriptor: any): void {
+  const count = descriptor.bytesFilled, aligned = count - count % descriptor.elementSize;
+  if (aligned > 0 && aligned !== count) {
+    const original = mapGet(originalContents, descriptor);
+    if (original === undefined) throw new TypeError('Missing pending byte-stream backing snapshot');
+    const bytes = new ByteArray(descriptor.buffer);
+    for (let at = aligned; at < count; ++at) bytes[descriptor.byteOffset + at] = original[at];
+  }
+  // Sub-element data remains in the returned backing, even when the view is empty.
+  descriptor.bytesFilled = aligned;
+}
+export function makeByteStreamEOFError(): Error {
+  if (internalError === undefined) throw new TypeError('Byte-stream profile is not configured');
+  return internalError('Standard byte-stream EOF has an incomplete typed-array element');
+}
+
+export function usesWorkerdReaderProfile(): boolean { return internalError !== undefined; }
+
+export function aliasDefaultReaderBuffer(buffer: ArrayBuffer): ArrayBuffer {
+  if (aliasBuffer === undefined) throw new TypeError('Byte-stream profile is not configured');
+  return aliasBuffer(buffer);
+}
+
+// Writable identity controls transform-pipe error handling independently of
+// the readable returned by pipeThrough. All lookups use captured intrinsics.
+export const readableForTransformWritable = new WeakMap<object, object>();
+export const profileTransformErrorStreams = new WeakMap<object, boolean>();
+export type ProfileTransformPipeFailure = (error: any, sourceAlreadyFailingOnly?: boolean) => void;
+export const profileTransformPipeFailures = new WeakMap<object, ProfileTransformPipeFailure>();
+// Cancellation completion records only link an actual transform pair. A
+// generic pair can return an unrelated readable; preventCancel also keeps
+// the original cancellation path.
+const transformPairs = new WeakMap<object, object>();
+type PipeCancellation = {source: object; completion: Promise<void>};
+const pipeCancellations = new WeakMap<object, PipeCancellation>();
+export const mapDelete = Function.prototype.call.bind(WeakMap.prototype.delete);
+export function rememberTransformPair(readable: object, writable: object): void {
+  mapSet(transformPairs, readable, writable);
+  mapSet(readableForTransformWritable, writable, readable);
+}
+export function rememberPipeCancellation(source: object, readable: object, writable: object,
+  completion: Promise<void>, preventCancel: boolean): void {
+  if (internalError === undefined || preventCancel || mapGet(transformPairs, readable) !== writable) return;
+  // Reject self/feedback records before they can make cancellation wait on
+  // its own pipe. The recorded parent graph remains acyclic.
+  let current: object | undefined = source;
+  while (current !== undefined) {
+    if (current === readable) return;
+    current = mapGet(pipeCancellations, current)?.source;
+  }
+  const record = {source, completion};
+  mapSet(pipeCancellations, readable, record);
+  const finished = () => {
+    if (mapGet(pipeCancellations, readable) === record) mapDelete(pipeCancellations, readable);
+    return null;
+  };
+  uponPromise(completion, finished, finished);
+}
+export function finishPipeCancellation<T>(stream: object, result: Promise<T>): Promise<T> {
+  const record = mapGet(pipeCancellations, stream) as PipeCancellation | undefined;
+  if (record === undefined) return result;
+  const after = <U>(settled: () => U) => transformPromiseWith(record.completion, settled, settled);
+  return transformPromiseWith(result, value => after(() => value), error => after(() => {throw error;}));
+}
