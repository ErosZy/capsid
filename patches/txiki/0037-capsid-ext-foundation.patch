+++ b/deps/quickjs/quickjs-ext-opcode.h
@@ -0,0 +1,35 @@
+/*
+ * QuickJS extended opcode table (BC27).
+ *
+ * An extended opcode is encoded as:
+ *
+ *     u8  OP_ext (252)
+ *     u8  ext_id
+ *     ... payload per the EXT_DEF size
+ *
+ * Like quickjs-opcode.h this file has no include guard: it is included
+ * once per macro context (EXT_FMT/EXT_DEF are redefined between includes).
+ * Every consumer (the interpreter dispatch, the bytecode readers and
+ * atom-free walk, the stack verifier, the dumps, and the capsid AOT
+ * optimizer) derives its tables from this single definition; ext_id 0,
+ * reserved ids, unknown ids, truncated payloads, recursive ext prefixes
+ * and targets inside payloads fail closed in every consumer.
+ *
+ * The format column values are collected by the EXT_FMT macro (one
+ * EXT_FMT(fmt) line per distinct value, mirroring quickjs-opcode.h).
+ *
+ * Catalog rules (docs/quickjs-ng-cfg-ssa-shape-ic.md §4.2):
+ *   - id 0 is reserved and always invalid;
+ *   - ids are contiguous from 1 and never renumbered;
+ *   - an id is added only together with its handler, verifier metadata,
+ *     malformed-input tests and canonical serializer support;
+ *   - a removed id stays reserved and rejected (keep the row, size 0).
+ */
+#ifndef EXT_DEF
+#error "quickjs-ext-opcode.h requires EXT_DEF to be defined"
+#endif
+
+EXT_FMT(none)
+
+/* ext_id, name, size (incl. OP_ext prefix + ext_id), n_pop, n_push, fmt */
+EXT_DEF(0, invalid, 0, 0, 0, none) /* reserved: never a valid id */
