+   definition table in quickjs-ext-opcode.h is the single source of truth
+   for every consumer: interpreter dispatch, serialization readers, the
+   atom-free walk, the dumps, and the capsid AOT optimizer. ext_id 0 and
+   unknown ids fail closed everywhere. */
+typedef enum {
+#define EXT_FMT(f) EXT_FMT_##f,
+#define EXT_DEF(id, name, size, n_pop, n_push, fmt)
+#include "quickjs-ext-opcode.h"
+#undef EXT_DEF
+#undef EXT_FMT
+} ExtFmt;
+
+enum {
+#define EXT_FMT(f)
+#define EXT_DEF(id, name, size, n_pop, n_push, fmt) EXT_##name = (id),
+#include "quickjs-ext-opcode.h"
+#undef EXT_DEF
+#undef EXT_FMT
+    EXT_COUNT
+};
+
+typedef struct JSExtOpcodeInfo {
+#ifdef ENABLE_DUMPS // JS_DUMP_BYTECODE_*
+    const char *name;
+#endif
+    uint8_t size; /* total instruction size: OP_ext prefix + ext_id + payload */
+    uint8_t n_pop;
+    uint8_t n_push;
+    uint8_t fmt;
+} JSExtOpcodeInfo;
+
+static const JSExtOpcodeInfo ext_opcode_info[EXT_COUNT] = {
+    /* every slot invalid by default: zeroed entries (size 0) are rejected
+       by ext_opcode_info_or_invalid() so holes and removed ids can never
+       be reached through the size gate */
+    [ 0 ... EXT_COUNT - 1 ] = { 0 },
+#define EXT_FMT(f)
+#ifdef ENABLE_DUMPS // JS_DUMP_BYTECODE_*
+#define EXT_DEF(id, name, size, n_pop, n_push, fmt) [ EXT_##name ] = { #name, size, n_pop, n_push, EXT_FMT_##fmt },
+#else
+#define EXT_DEF(id, name, size, n_pop, n_push, fmt) [ EXT_##name ] = { size, n_pop, n_push, EXT_FMT_##fmt },
+#endif
+#include "quickjs-ext-opcode.h"
+#undef EXT_DEF
+#undef EXT_FMT
+};
+
+/* NULL for invalid ext ids (0, reserved, holes and beyond EXT_COUNT). */
+static inline const JSExtOpcodeInfo *ext_opcode_info_or_invalid(int ext_id) {
+    if (ext_id > 0 && ext_id < EXT_COUNT) {
+        const JSExtOpcodeInfo *ei = &ext_opcode_info[ext_id];
+        if (ei->size != 0)   /* holes stay zeroed and fail closed */
+            return ei;
+    }
+    return NULL;
+}
