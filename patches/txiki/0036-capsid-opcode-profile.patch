+#ifdef CONFIG_OPCODE_PROFILE
+static inline uint8_t js_profile_fetch(JSRuntime *rt, uint8_t **pcp)
+{
+    uint8_t op = *(*pcp)++;
+    if (unlikely(rt->opcode_profile != NULL)) {
+        JSOpcodeProfile *p = rt->opcode_profile;
+        if (p->exec[op] != UINT64_MAX)
+            p->exec[op]++;
+    }
+    return op;
+}
+
+#define PROFILE_CLASS(rt_, array_, op_, sub_) do {                              \
+        JSOpcodeProfile *p_ = (rt_)->opcode_profile;                            \
+        if (unlikely(p_ != NULL) && p_->array_[op_][sub_] != UINT64_MAX)        \
+            p_->array_[op_][sub_]++;                                            \
+    } while (0)
+
+#define PROFILE_ARITH(ctx_, op_, cls_) PROFILE_CLASS((ctx_)->rt, arith, op_, cls_)
+#define PROFILE_BRANCH(ctx_, op_, taken_) \
+    PROFILE_CLASS((ctx_)->rt, branch, op_, (taken_) != 0)
+#define PROFILE_PROP(ctx_, op_, cls_) PROFILE_CLASS((ctx_)->rt, prop, op_, cls_)
+
+#define PROFILE_CALL(ctx_, op_, argc_) do {                                     \
+        JSOpcodeProfile *p_ = (ctx_)->rt->opcode_profile;                       \
+        if (unlikely(p_ != NULL)) {                                             \
+            int idx_ = (argc_) >= 4 ? 4 : (argc_);                              \
+            if (p_->call_argc[op_][idx_] != UINT64_MAX)                         \
+                p_->call_argc[op_][idx_]++;                                     \
+        }                                                                       \
+    } while (0)
+
+#else /* !CONFIG_OPCODE_PROFILE: empty expansions keep codegen identical */
+
+#define PROFILE_ARITH(ctx_, op_, cls_) do { } while (0)
+#define PROFILE_BRANCH(ctx_, op_, taken_) do { } while (0)
+#define PROFILE_PROP(ctx_, op_, cls_) do { } while (0)
+#define PROFILE_CALL(ctx_, op_, argc_) do { } while (0)
+
+#endif /* CONFIG_OPCODE_PROFILE */
+
+#ifdef CONFIG_OPCODE_PROFILE
+static const char * const opcode_profile_names[OP_COUNT] = {
+#define DEF(id, size, n_pop, n_push, f) #id,
+#define def(id, size, n_pop, n_push, f)
+#include "quickjs-opcode.h"
+#undef DEF
+#undef def
+};
+
+static void js_profile_dump_matrix(FILE *fp, uint64_t (*m)[5],
+                                   const char *const *cols, int ncols)
+{
+    int op, c, obj_first = 1;
+    fputc('{', fp);
+    for (op = 0; op < OP_COUNT; op++) {
+        int row, row_first = 1;
+        for (c = 0; c < ncols; c++) {
+            if (m[op][c] != 0) {
+                row_first = 0;
+                break;
+            }
+        }
+        if (row_first)
+            continue;
+        if (!obj_first)
+            fputc(',', fp);
+        obj_first = 0;
+        fprintf(fp, "\"%s\":{", opcode_profile_names[op]);
+        row = 1;
+        for (c = 0; c < ncols; c++) {
+            if (m[op][c] == 0)
+                continue;
+            if (!row)
+                fputc(',', fp);
+            row = 0;
+            fprintf(fp, "\"%s\":%llu", cols[c], (unsigned long long)m[op][c]);
+        }
+        fputc('}', fp);
+    }
+    fputc('}', fp);
+}
+
+void JS_DumpOpcodeProfile(FILE *fp, JSRuntime *rt)
+{
+    JSOpcodeProfile *p = rt->opcode_profile;
+    int op, first = 1;
+    static const char * const arith_cols[] = { "int", "float", "other" };
+    static const char * const branch_cols[] = { "untaken", "taken" };
+    static const char * const argc_cols[] = { "0", "1", "2", "3", "4plus" };
+    static const char * const prop_cols[] = { "fast", "slow" };
+
+    if (!p) {
+        fputs("{}\n", fp);
+        return;
+    }
+    fputs("{\"schema\":\"quickjs-ng-opcode-profile-v1\",\"runtime\":", fp);
+    fprintf(fp, "%llu", (unsigned long long)p->id);
+    fputs(",\"exec\":{", fp);
+    for (op = 0; op < OP_COUNT; op++) {
+        if (p->exec[op] == 0)
+            continue;
+        if (!first)
+            fputc(',', fp);
+        first = 0;
+        fprintf(fp, "\"%s\":%llu", opcode_profile_names[op],
+                (unsigned long long)p->exec[op]);
+    }
+    fputs("},\"arith\":", fp);
+    js_profile_dump_matrix(fp, p->arith, arith_cols, 3);
+    fputs(",\"branch\":", fp);
+    js_profile_dump_matrix(fp, p->branch, branch_cols, 2);
+    fputs(",\"call_argc\":", fp);
+    js_profile_dump_matrix(fp, p->call_argc, argc_cols, 5);
+    fputs(",\"prop\":", fp);
+    js_profile_dump_matrix(fp, p->prop, prop_cols, 2);
+    fputs("}\n", fp);
+}
+#endif /* CONFIG_OPCODE_PROFILE */
