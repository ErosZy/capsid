 /* argv[] is modified if (flags & JS_CALL_FLAG_COPY_ARGV) = 0. */
+/* Native calls do not need the interpreter's large stack frame. Keeping
+ * dispatch outside it avoids initializing that frame on every built-in call,
+ * especially with MSVC ASan. The common entry still polls exactly once. */
+static no_inline JSValue JS_CallInternalBytecode(JSContext *caller_ctx,
+    JSValueConst func_obj, JSValueConst this_obj, JSValueConst new_target,
+    int argc, JSValueConst *argv, int flags);
+
 static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
+    JSValueConst this_obj, JSValueConst new_target,
+    int argc, JSValueConst *argv, int flags)
+{
+    if (js_poll_interrupts(caller_ctx))
+        return JS_EXCEPTION;
+    if (unlikely(JS_VALUE_GET_TAG(func_obj) != JS_TAG_OBJECT)) {
+        if (!(flags & JS_CALL_FLAG_GENERATOR))
+            return JS_ThrowTypeErrorNotAFunction(caller_ctx);
+    } else {
+        JSObject *p = JS_VALUE_GET_OBJ(func_obj);
+        if (unlikely(p->class_id != JS_CLASS_BYTECODE_FUNCTION)) {
+            JSClassCall *call_func = caller_ctx->rt->class_array[p->class_id].call;
+            if (!call_func)
+                return JS_ThrowTypeErrorNotAFunction(caller_ctx);
+            return call_func(caller_ctx, func_obj, this_obj, argc, argv, flags);
+        }
+    }
+    return JS_CallInternalBytecode(caller_ctx, func_obj, this_obj, new_target,
+                                   argc, argv, flags);
+}
