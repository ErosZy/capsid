diff --git a/CMakeLists.txt b/CMakeLists.txt
index 53cc1ea..96220e3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -246,7 +246,39 @@ add_executable(tjsc EXCLUDE_FROM_ALL
 ### Dependencies
 ###
 
-add_subdirectory(deps/quickjs EXCLUDE_FROM_ALL)
+# Capsid: build QuickJS through quickjs-turbo's audited VM overlay (deps/quickjs/vm).
+set(QJS_BUILD_CLI OFF CACHE BOOL "" FORCE)
+set(QJS_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
+set(QJS_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
+set(QJS_FRAME_BUILD_TESTS OFF CACHE BOOL "" FORCE)
+set(QJS_BACKPORT_CONTEXT_OOM ON CACHE BOOL "" FORCE)
+set(QJS_BACKPORT_COMPUTED_ASSIGN ON CACHE BOOL "" FORCE)
+set(QJS_BACKPORT_VALUE64_INIT ON CACHE BOOL "" FORCE)
+set(QJS_BACKPORT_MIXED_NUMBERS ON CACHE BOOL "" FORCE)
+set(QJS_BACKPORT_MAP_POINTER_HASH ON CACHE BOOL "" FORCE)
+set(QJS_BACKPORT_PORTABLE_REGEXP ON CACHE BOOL "" FORCE)
+set(QJS_PROPERTY_IC ON CACHE BOOL "" FORCE)
+set(QJS_HYBRID_GC ON CACHE BOOL "" FORCE)
+if(BUILD_WITH_ASAN OR BUILD_WITH_UBSAN OR CAPSID_ENABLE_ASAN OR CAPSID_ENABLE_UBSAN OR CAPSID_ENABLE_TSAN)
+    set(QJS_FRAME_BACKEND "PORTABLE" CACHE STRING "" FORCE)
+elseif(NOT (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$"))
+    set(QJS_FRAME_BACKEND "PORTABLE" CACHE STRING "" FORCE)
+elseif(NOT DEFINED QJS_FRAME_BACKEND)
+    set(QJS_FRAME_BACKEND "AUTO" CACHE STRING "" FORCE)
+endif()
+set(_capsid_saved_ipo "${CMAKE_INTERPROCEDURAL_OPTIMIZATION}")
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux"
+   AND CMAKE_C_COMPILER_ID STREQUAL "GNU"
+   AND CMAKE_C_COMPILER_VERSION VERSION_GREATER_EQUAL 13
+   AND CMAKE_SIZEOF_VOID_P EQUAL 8
+   AND NOT CMAKE_CROSSCOMPILING
+   AND NOT (QJS_FRAME_BACKEND STREQUAL "PORTABLE"))
+    # Linux native x86-64 register-frame assembly VM does not admit LTO on libqjs;
+    # keep LTO active for tjs and capsid-worker while building libqjs natively.
+    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION FALSE)
+endif()
+add_subdirectory(deps/quickjs/vm EXCLUDE_FROM_ALL)
+set(CMAKE_INTERPROCEDURAL_OPTIMIZATION "${_capsid_saved_ipo}")
 target_link_libraries(tjs PUBLIC qjs)
 target_link_libraries(tjsc qjs)
 
