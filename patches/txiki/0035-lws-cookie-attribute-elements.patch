+	/* --- AV-backed, order must match cft[] --- */
 	CE_DOMAIN,
 	CE_PATH,
 	CE_EXPIRES,
 	CE_MAXAGE,
+	CE_HTTPONLY,	/* bool, NULL = 0, non-NULL = 1 */
