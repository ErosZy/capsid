+
+	/* --- not AVs --- */
 	CE_NAME,
 	CE_VALUE,
-
-	CE_HOSTONLY, /* these are bool, NULL = 0, non-NULL = 1 */
-	CE_SECURE,
+	CE_HOSTONLY,	/* bool, NULL = 0, non-NULL = 1 */
 
 	CE_COUNT
 };
