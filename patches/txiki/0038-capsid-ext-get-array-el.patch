diff --git a/deps/quickjs/quickjs-ext-opcode.h b/deps/quickjs/quickjs-ext-opcode.h
index 531c74c..edce3b5 100644
--- a/deps/quickjs/quickjs-ext-opcode.h
+++ b/deps/quickjs/quickjs-ext-opcode.h
@@ -33,3 +33,4 @@ EXT_FMT(none)
 
 /* ext_id, name, size (incl. OP_ext prefix + ext_id), n_pop, n_push, fmt */
 EXT_DEF(0, invalid, 0, 0, 0, none) /* reserved: never a valid id */
+EXT_DEF(1, get_array_el, 2, 2, 1, none)
diff --git a/deps/quickjs/quickjs.c b/deps/quickjs/quickjs.c
index fada34d..4da1372 100644
--- a/deps/quickjs/quickjs.c
+++ b/deps/quickjs/quickjs.c
@@ -19765,6 +19765,37 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
 #else
                 switch (ext_id) {
 #endif
+        EXT_CASE(1, get_array_el)
+            {
+                JSValue val;
+                JSObject *p;
+                uint32_t idx;
+
+                /* Tag-specialized fast path: proven array + int index.
+                   Exactly the fast path JS_GetPropertyValue takes, inlined
+                   so the site avoids the generic entry checks. */
+                if (likely(JS_VALUE_GET_TAG(sp[-2]) == JS_TAG_OBJECT &&
+                           JS_VALUE_GET_TAG(sp[-1]) == JS_TAG_INT)) {
+                    p = JS_VALUE_GET_OBJ(sp[-2]);
+                    idx = JS_VALUE_GET_INT(sp[-1]);
+                    if (likely(js_get_fast_array_element(ctx, p, idx, &val))) {
+                        JS_FreeValue(ctx, sp[-2]);
+                        JS_FreeValue(ctx, sp[-1]);
+                        sp[-2] = val;
+                        sp--;
+                        EXT_BREAK;
+                    }
+                }
+                /* Generic fallback: identical semantics to OP_get_array_el. */
+                sf->cur_pc = pc;
+                val = JS_GetPropertyValue(ctx, sp[-2], sp[-1]);
+                JS_FreeValue(ctx, sp[-2]);
+                sp[-2] = val;
+                sp--;
+                if (unlikely(JS_IsException(val)))
+                    goto exception;
+                EXT_BREAK;
+            }
         EXT_DEFAULT:
             JS_ThrowInternalError(ctx,
                                   "invalid ext opcode: pc=%u ext_id=0x%02x",
@@ -38116,6 +38147,9 @@ typedef enum BCTagEnum {
 
 typedef struct BCWriterState {
     JSContext *ctx;
+    /* set when a written function contains an OP_ext instruction: the
+       bundle is then emitted as BC_VERSION_EXT (canonical only with ext) */
+    bool has_ext_op;
     DynBuf dbuf;
     bool allow_bytecode;
     bool allow_sab;
@@ -38304,9 +38338,21 @@ static int JS_WriteFunctionBytecode(BCWriterState *s,
 
     pos = 0;
     while (pos < bc_len) {
+        const JSOpCode *oi;
         op = bc_buf[pos];
-        len = short_opcode_info(op).size;
-        switch(short_opcode_info(op).fmt) {
+        oi = &short_opcode_info(op);
+        if (oi->fmt == OP_FMT_ext) {
+            /* extended opcode: size comes from the ext table; a function
+               containing one is emitted as BC27 by JS_WriteObject2 */
+            const JSExtOpcodeInfo *ei;
+            if (pos + 1 >= bc_len || (ei = ext_opcode_info_or_invalid(bc_buf[pos + 1])) == NULL)
+                goto fail;
+            s->has_ext_op = true;
+            len = ei->size;
+        } else {
+            len = oi->size;
+        }
+        switch(oi->fmt) {
         case OP_FMT_atom:
         case OP_FMT_atom_u8:
         case OP_FMT_atom_u16:
@@ -38927,6 +38973,10 @@ uint8_t *JS_WriteObject2(JSContext *ctx, size_t *psize, JSValueConst obj,
     d = &s->dbuf;
     h = bc_csum(&d->buf[5], d->size - 5);
     put_u32(&d->buf[1], h);
+    /* BC27 is canonical only when an ext instruction is present; the
+       version byte is outside the checksum range so this patch is safe */
+    if (s->has_ext_op)
+        d->buf[0] = BC_VERSION_EXT;
     return d->buf;
  fail:
     js_object_list_end(ctx, &s->object_list);
