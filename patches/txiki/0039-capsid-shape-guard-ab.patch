+#if defined(CONFIG_SHAPE_GUARD_ID32) || defined(CONFIG_SHAPE_GUARD_STRONG_REF)
+/* S0 §5.1: flat shape-guard site + A/B measurement API. One site per
+   (runtime, caller key); the caller (tests/test_shape_guard.cc) holds
+   the pointer. State machine: 0 = disabled, 1 = mono (guarded),
+   2 = generic (a non-guardable value was seen; stays generic).
+   ID32 compares shape ids (identity survives address reuse and GC);
+   STRONG_REF keeps the guarded shape alive with a dup so its address
+   is stable for the site's lifetime. No production code touches these
+   sites: the S0 verdict is measurement-only. */
+typedef struct JSICShapeGuardSite {
+    struct JSICShapeGuardSite *next;  /* JSRuntime.shape_guard_sites */
+    uint32_t state;
+    uint64_t hits;
+    uint64_t misses;
+#if defined(CONFIG_SHAPE_GUARD_ID32)
+    uint32_t shape_id;
+#else
+    JSShape *shape; /* STRONG_REF: kept alive by this dup */
+#endif
+} JSICShapeGuardSite;
+
+/* Called from JS_FreeRuntime before JS_RunGC(): drop the dup a
+   STRONG_REF site holds on its guarded shape so the GC can collect it,
+   then free the site allocation. */
+static void js_ic_shape_guard_free_all(JSRuntime *rt)
+{
+    while (rt->shape_guard_sites) {
+        JSICShapeGuardSite *site = rt->shape_guard_sites;
+        rt->shape_guard_sites = site->next;
+#if defined(CONFIG_SHAPE_GUARD_STRONG_REF)
+        if (site->shape)
+            js_free_shape(rt, site->shape);
+#endif
+        js_free_rt(rt, site);
+    }
+}
+
+static JSICShapeGuardSite *js_ic_shape_guard_new(JSRuntime *rt)
+{
+    JSICShapeGuardSite *site;
+
+    site = js_mallocz_rt(rt, sizeof(*site));
+    if (!site)
+        return NULL;
+    site->next = rt->shape_guard_sites;
+    rt->shape_guard_sites = site;
+    return site;
+}
+
+static void js_ic_shape_guard_update_site(JSContext *ctx,
+                                          JSICShapeGuardSite *site,
+                                          JSObject *obj)
+{
+    JSShape *sh;
+
+    if (!site || site->state == 2)
+        return;
+    sh = obj->shape;
+#if defined(CONFIG_SHAPE_GUARD_ID32)
+    if (ctx->rt->shape_id_disabled) {
+        site->state = 2;
+        return;
+    }
+    if (sh->shape_id == 0) {
+        /* shape built before the counter or while disabled */
+        site->state = 2;
+        return;
+    }
+    site->shape_id = sh->shape_id;
+#else
+    if (site->shape)
+        js_free_shape(ctx->rt, site->shape);
+    site->shape = js_dup_shape(sh);
+#endif
+    site->hits = 0;
+    site->misses = 0;
+    site->state = 1;
+}
+
+static void js_ic_shape_guard_free_site(JSRuntime *rt,
+                                        JSICShapeGuardSite *site)
+{
+    JSICShapeGuardSite **pp;
+
+    if (!site)
+        return;
+#if defined(CONFIG_SHAPE_GUARD_STRONG_REF)
+    if (site->shape)
+        js_free_shape(rt, site->shape);
+#endif
+    for (pp = &rt->shape_guard_sites; *pp && *pp != site; pp = &(*pp)->next)
+        ;
+    if (*pp)
+        *pp = site->next;
+    js_free_rt(rt, site);
+}
+
+JSICShapeGuardSite *JS_ICShapeGuardNew(JSRuntime *rt)
+{
+    return js_ic_shape_guard_new(rt);
+}
+
+/* Warm or retrain a site on 'obj'. Returns 0 once the site guards the
+   object, -1 if the site is generic or the value is not guardable. */
+int JS_ICShapeGuardUpdate(JSContext *ctx, JSICShapeGuardSite *site,
+                          JSValue obj)
+{
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT)
+        return -1;
+    js_ic_shape_guard_update_site(ctx, site, JS_VALUE_GET_OBJ(obj));
+    return (site && site->state == 1) ? 0 : -1;
+}
+
+/* Returns 1 on a guarded-shape hit, 0 otherwise (including non-object
+   values and sites in state 0/2). Misses are counted but never change
+   state: the caller retrains through JS_ICShapeGuardUpdate(). */
+int JS_ICShapeGuardCheck(JSICShapeGuardSite *site, JSValue obj)
+{
+    if (!site || site->state != 1)
+        return 0;
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT)
+        return 0;
+#if defined(CONFIG_SHAPE_GUARD_ID32)
+    if (JS_VALUE_GET_OBJ(obj)->shape->shape_id == site->shape_id) {
+#else
+    if (JS_VALUE_GET_OBJ(obj)->shape == site->shape) {
+#endif
+        site->hits++;
+        return 1;
+    }
+    site->misses++;
+    return 0;
+}
+
+void JS_ICShapeGuardRelease(JSRuntime *rt, JSICShapeGuardSite *site)
+{
+    js_ic_shape_guard_free_site(rt, site);
+}
+
+uint64_t JS_ICShapeGuardHits(JSICShapeGuardSite *site)
+{
+    return site ? site->hits : 0;
+}
+
+/* 1 if identity checking is active for this runtime (always true under
+   STRONG_REF; false once the ID32 counter wraps). */
+int JS_ICShapeGuardEnabled(JSRuntime *rt)
+{
+#if defined(CONFIG_SHAPE_GUARD_ID32)
+    return !rt->shape_id_disabled;
+#else
+    return 1;
+#endif
+}
+
+#if defined(CONFIG_SHAPE_GUARD_ID32)
+/* Directed wrap test: place the counter one below UINT32_MAX so the
+   next assignment disables identity checking. */
+void JS_ICShapeGuardSetCounterForTest(JSRuntime *rt, uint32_t v)
+{
+    rt->shape_id_counter = v;
+    rt->shape_id_disabled = false;
+}
+#endif
+
+#endif  /* shape guard backends */
