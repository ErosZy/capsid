+#if defined(CONFIG_SHAPE_GUARD_ID32)
+/* S0 §5.1 ID32: assign the next monotonic identity to a shape. Called
+   on every creation (new/clone/resize/compact) and on every in-place
+   mutation via js_shape_prepare_update(), so a shape's id changes
+   whenever its content does. The memcpy paths (clone/resize/compact)
+   copy the old id inside the copied struct and must call this to
+   override it. A wrap of the counter permanently disables identity
+   checking for the runtime: a recycled id can never produce a stale
+   guard hit. */
+static inline uint32_t js_shape_assign_id(JSRuntime *rt, JSShape *sh)
+{
+    uint32_t id;
+
+    if (unlikely(rt->shape_id_disabled))
+        return 0;
+    id = ++rt->shape_id_counter;
+    if (unlikely(id == 0)) {
+        rt->shape_id_disabled = true;
+        return 0;
+    }
+    sh->shape_id = id;
+    return id;
+}
+#endif
