+static void store_error_source(JSContext *ctx, JSValueConst error, JSAtom filename,
+                               int line, int column)
+{
+    if (JS_VALUE_GET_TAG(error) != JS_TAG_OBJECT || filename == JS_ATOM_NULL)
+        return;
+    JSObject *p = JS_VALUE_GET_OBJ(error);
+    if (p->class_id != JS_CLASS_ERROR || p->u.error_data.source)
+        return;
+    /* Backtrace construction must not replace the original exception on OOM. */
+    JSErrorSourceLocation *source = js_malloc_rt(ctx->rt, sizeof(*source));
+    if (!source) return;
+    source->filename = JS_DupAtom(ctx, filename);
+    source->line = line;
+    source->column = column;
+    p->u.error_data.source = source;
+}
+
+void JS_GetErrorSourceLocation(JSContext *ctx, JSValueConst error,
+                              JSValue *filename, int *line, int *column)
+{
+    *filename = JS_UNDEFINED;
+    *line = 0;
+    *column = -1;
+    if (JS_VALUE_GET_TAG(error) != JS_TAG_OBJECT) return;
+    JSObject *p = JS_VALUE_GET_OBJ(error);
+    if (p->class_id != JS_CLASS_ERROR || !p->u.error_data.source) return;
+    *filename = JS_AtomToString(ctx, p->u.error_data.source->filename);
+    *line = p->u.error_data.source->line;
+    /* QuickJS source columns are one-based; ErrorEvent exposes zero-based. */
+    *column = p->u.error_data.source->column - 1;
+}
