+/* Preserve an HTTP/1.x response's reason phrase for Fetch Response.statusText.
+ * libwebsockets stores the status-line value in WSI_TOKEN_HTTP (or
+ * WSI_TOKEN_HTTP1_0); HTTP/2 and HTTP/3 have only :status and therefore
+ * intentionally produce an empty status text. */
+static JSValue response_status_text(JSContext *ctx, struct lws *wsi) {
+    int token = WSI_TOKEN_HTTP;
+    int length = lws_hdr_total_length(wsi, token);
+    if (length <= 0) {
+        token = WSI_TOKEN_HTTP1_0;
+        length = lws_hdr_total_length(wsi, token);
+    }
+    if (length <= 0) {
+        return JS_NewString(ctx, "");
+    }
+
+    char *status_line = js_malloc(ctx, (size_t) length + 1);
+    if (!status_line) {
+        return JS_EXCEPTION;
+    }
+    if (lws_hdr_copy(wsi, status_line, length + 1, token) < 0) {
+        js_free(ctx, status_line);
+        return JS_NewString(ctx, "");
+    }
+
+    char *text = status_line;
+    while (*text == ' ' || *text == '\t') {
+        text++;
+    }
+    while (*text >= '0' && *text <= '9') {
+        text++;
+    }
+    while (*text == ' ' || *text == '\t') {
+        text++;
+    }
+
+    JSValue result = JS_NewString(ctx, text);
+    js_free(ctx, status_line);
+    return result;
+}
