+static JSOpcodeSiteProfile *js_profile_site(JSRuntime *rt,
+                                            JSOpcodeProfile *p,
+                                            JSFunctionBytecode *b,
+                                            const uint8_t *pc, int op,
+                                            bool count_overflow)
+{
+    JSOpcodeSiteProfile *site;
+    uint32_t function_id, off, slot, probe;
+
+    if (!p || pc < b->byte_code_buf ||
+        pc >= b->byte_code_buf + b->byte_code_len)
+        return NULL;
+    function_id = b->opcode_profile_id;
+    if (function_id == 0) {
+        function_id = ++p->next_function_id;
+        if (unlikely(function_id == 0))
+            function_id = ++p->next_function_id;
+        b->opcode_profile_id = function_id;
+    }
+    off = (uint32_t)(pc - b->byte_code_buf);
+    slot = (function_id * 2654435761u ^ off * 2246822519u ^ (uint32_t)op) &
+           (JS_PROFILE_SITES - 1);
+    for (probe = 0; probe < 256; probe++) {
+        site = &p->sites[(slot + probe) & (JS_PROFILE_SITES - 1)];
+        if (site->function_id == 0) {
+            site->function_id = function_id;
+            site->pc = off;
+            site->op = op;
+            site->source_hash = js_profile_source_hash(rt, b);
+            site->code_hash = js_profile_code_hash(b);
+            site->code_len = b->byte_code_len;
+            site->line_num = b->line_num;
+            site->col_num = b->col_num;
+        }
+        if (site->function_id == function_id && site->pc == off &&
+            site->op == op)
+            return site;
+    }
+    if (count_overflow && p->site_overflow != UINT64_MAX)
+        p->site_overflow++;
+    return NULL;
+}
