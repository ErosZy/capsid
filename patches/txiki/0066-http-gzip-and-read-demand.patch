+/* HTTP-specific gzip decoder shared by the client and direct parser tests. */
+#ifndef TJS_HTTP_GZIP_H
+#define TJS_HTTP_GZIP_H
+#include "tbuf.h"
+#include <miniz.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+
+/* HTTP content decoding has a different contract from DecompressionStream:
+ * gzip members concatenate, and an unfinished member fails at response EOF.
+ * Keep the HTTP parser independent from the public compression primitives. */
+enum {
+    HTTP_GZIP_HEADER,
+    HTTP_GZIP_EXTRA_LENGTH,
+    HTTP_GZIP_EXTRA,
+    HTTP_GZIP_NAME,
+    HTTP_GZIP_COMMENT,
+    HTTP_GZIP_HEADER_CRC,
+    HTTP_GZIP_DATA,
+    HTTP_GZIP_TRAILER,
+    HTTP_GZIP_DONE,
+    HTTP_GZIP_FAILED
+};
+
+typedef struct {
+    JSContext *ctx;
+    mz_stream stream;
+    int state;
+    bool initialized;
+    uint8_t fixed[10];
+    size_t fixed_size;
+    uint8_t flags;
+    uint8_t pair[2];
+    size_t pair_size;
+    uint16_t extra_remaining;
+    uint8_t trailer[8];
+    size_t trailer_size;
+    mz_ulong header_crc;
+    mz_ulong crc;
+    uint32_t total;
+} TJSHttpGzip;
+
+static TJSHttpGzip *http_gzip_create(JSContext *ctx) {
+    TJSHttpGzip *d = js_mallocz(ctx, sizeof(*d));
+    if (d) {
+        d->ctx = ctx;
+        d->header_crc = MZ_CRC32_INIT;
+        d->crc = MZ_CRC32_INIT;
+    }
+    return d;
+}
+
+static void http_gzip_destroy(TJSHttpGzip *d, JSRuntime *rt) {
+    if (d->initialized) {
+        mz_inflateEnd(&d->stream);
+    }
+    js_free_rt(rt, d);
+}
+
+static int http_gzip_after_header(TJSHttpGzip *d) {
+    if (d->flags & 4) {
+        d->flags &= (uint8_t) ~4u;
+        d->pair_size = 0;
+        d->state = HTTP_GZIP_EXTRA_LENGTH;
+    } else if (d->flags & 8) {
+        d->flags &= (uint8_t) ~8u;
+        d->state = HTTP_GZIP_NAME;
+    } else if (d->flags & 16) {
+        d->flags &= (uint8_t) ~16u;
+        d->state = HTTP_GZIP_COMMENT;
+    } else if (d->flags & 2) {
+        d->flags &= (uint8_t) ~2u;
+        d->pair_size = 0;
+        d->state = HTTP_GZIP_HEADER_CRC;
+    } else {
+        if (mz_inflateInit2(&d->stream, -MZ_DEFAULT_WINDOW_BITS) != MZ_OK) {
+            return -1;
+        }
+        d->initialized = true;
+        d->state = HTTP_GZIP_DATA;
+    }
+    return 0;
+}
+
+static uint32_t http_gzip_le32(const uint8_t *p) {
+    return (uint32_t) p[0] | ((uint32_t) p[1] << 8)
+        | ((uint32_t) p[2] << 16) | ((uint32_t) p[3] << 24);
+}
+
+/* Returns -1 on malformed input, 0 when more input is needed, 1 at a
+ * validated member boundary, or 2 when a complete 4096-byte output block
+ * is available. No input beyond the current member is consumed. */
+static int http_gzip_step(TJSHttpGzip *d, const uint8_t *input, size_t length,
+                          size_t *consumed, TBuf *out) {
+    size_t position = 0;
+    *consumed = 0;
+    if (d->state == HTTP_GZIP_FAILED) {
+        return -1;
+    }
+    if (d->state == HTTP_GZIP_DONE) {
+        if (!length) {
+            return 1;
+        }
+        if (d->initialized) {
+            mz_inflateEnd(&d->stream);
+            d->initialized = false;
+        }
+        memset(&d->stream, 0, sizeof(d->stream));
+        d->state = HTTP_GZIP_HEADER;
+        d->fixed_size = d->pair_size = d->trailer_size = 0;
+        d->header_crc = d->crc = MZ_CRC32_INIT;
+        d->total = 0;
+    }
+    for (;;) {
+        if (d->state < HTTP_GZIP_DATA) {
+            if (position == length) {
+                *consumed = position;
+                return 0;
+            }
+            uint8_t byte = input[position++];
+            if (d->state != HTTP_GZIP_HEADER_CRC) {
+                d->header_crc = mz_crc32(d->header_crc, &byte, 1);
+            }
+            switch (d->state) {
+                case HTTP_GZIP_HEADER:
+                    d->fixed[d->fixed_size++] = byte;
+                    if (d->fixed_size == sizeof(d->fixed)) {
+                        if (d->fixed[0] != 31 || d->fixed[1] != 139
+                            || d->fixed[2] != 8 || (d->fixed[3] & 224)) {
+                            goto invalid;
+                        }
+                        d->flags = d->fixed[3];
+                        if (http_gzip_after_header(d) < 0) goto invalid;
+                    }
+                    break;
+                case HTTP_GZIP_EXTRA_LENGTH:
+                    d->pair[d->pair_size++] = byte;
+                    if (d->pair_size == 2) {
+                        d->extra_remaining = (uint16_t) d->pair[0] | ((uint16_t) d->pair[1] << 8);
+                        d->state = HTTP_GZIP_EXTRA;
+                        if (!d->extra_remaining && http_gzip_after_header(d) < 0) goto invalid;
+                    }
+                    break;
+                case HTTP_GZIP_EXTRA:
+                    if (!--d->extra_remaining && http_gzip_after_header(d) < 0) goto invalid;
+                    break;
+                case HTTP_GZIP_NAME:
+                case HTTP_GZIP_COMMENT:
+                    if (!byte && http_gzip_after_header(d) < 0) goto invalid;
+                    break;
+                case HTTP_GZIP_HEADER_CRC:
+                    d->pair[d->pair_size++] = byte;
+                    if (d->pair_size == 2) {
+                        uint16_t expected = (uint16_t) d->pair[0] | ((uint16_t) d->pair[1] << 8);
+                        if (expected != (uint16_t) d->header_crc || http_gzip_after_header(d) < 0) goto invalid;
+                    }
+                    break;
+            }
+            continue;
+        }
+        if (d->state == HTTP_GZIP_DATA) {
+            uint8_t buffer[4096];
+            size_t available = length - position;
+            mz_uint32 offered = available > UINT32_MAX ? UINT32_MAX : (mz_uint32) available;
+            d->stream.next_in = input + position;
+            d->stream.avail_in = offered;
+            d->stream.next_out = buffer;
+            d->stream.avail_out = (mz_uint32) (sizeof(buffer) - out->size);
+            mz_uint32 room = d->stream.avail_out;
+            int status = mz_inflate(&d->stream, MZ_SYNC_FLUSH);
+            size_t used = offered - d->stream.avail_in;
+            size_t produced = room - d->stream.avail_out;
+            position += used;
+            if (status != MZ_OK && status != MZ_STREAM_END && status != MZ_BUF_ERROR) goto invalid;
+            if (produced) {
+                d->crc = mz_crc32(d->crc, buffer, produced);
+                d->total += (uint32_t) produced;
+                if (tbuf_put(out, buffer, produced) < 0) goto invalid;
+            }
+            if (status == MZ_STREAM_END) {
+                d->state = HTTP_GZIP_TRAILER;
+            } else if (out->size == sizeof(buffer)) {
+                *consumed = position;
+                return 2;
+            } else if (position == length) {
+                *consumed = position;
+                return 0;
+            } else if (!used && !produced) {
+                goto invalid;
+            }
+            continue;
+        }
+        if (d->state == HTTP_GZIP_TRAILER) {
+            while (position < length && d->trailer_size < sizeof(d->trailer)) {
+                d->trailer[d->trailer_size++] = input[position++];
+            }
+            if (d->trailer_size < sizeof(d->trailer)) {
+                *consumed = position;
+                return 0;
+            }
+            if (http_gzip_le32(d->trailer) != (uint32_t) d->crc
+                || http_gzip_le32(d->trailer + 4) != d->total) goto invalid;
+            d->state = HTTP_GZIP_DONE;
+            *consumed = position;
+            return 1;
+        }
+        goto invalid;
+    }
+invalid:
+    d->state = HTTP_GZIP_FAILED;
+    *consumed = position;
+    return -1;
+}
+
+#endif
