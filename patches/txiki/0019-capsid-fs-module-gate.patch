+#ifdef TJS_RESTRICTED_CORE
+/* Capsid Binding v1: the per-origin FS gate decides every filesystem
+ * entry point before the syscall; mutations need the write path. */
+static bool tjs__fs_gate(JSContext *ctx, const char *path, int write_access) {
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    if (!qrt || !qrt->capsid_fs.check) {
+        JS_ThrowTypeError(ctx, "fs policy is unavailable");
+        return false;
+    }
+    char reason[TJS_EGRESS_REASON_MAX] = { 0 };
+    if (!qrt->capsid_fs.check(qrt->capsid_fs.opaque, path, write_access,
+                              reason, sizeof(reason))) {
+        JS_ThrowTypeError(ctx, "%s",
+                          reason[0] ? reason : "fs access denied");
+        return false;
+    }
+    return true;
 }
+#endif
 
