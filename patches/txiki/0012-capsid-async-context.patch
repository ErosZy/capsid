+void JS_SetJobContextHooks(JSRuntime *rt, const JSJobContextHooks *hooks,
+                           void *opaque)
+{
+    if (hooks) {
+        rt->job_ctx_hooks = *hooks;
+    } else {
+        memset(&rt->job_ctx_hooks, 0, sizeof(rt->job_ctx_hooks));
+    }
+    rt->job_ctx_opaque = opaque;
+}
