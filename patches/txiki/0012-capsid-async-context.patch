 typedef int JSInterruptHandler(JSRuntime *rt, void *opaque);
 JS_EXTERN void JS_SetInterruptHandler(JSRuntime *rt, JSInterruptHandler *cb, void *opaque);
 /* if can_block is true, Atomics.wait() can be used */
+
+/* job context hooks: an embedder may attach an opaque identity to each
+   enqueued job so asynchronous continuations can be attributed to their
+   owning request. Not installed -> upstream behavior unchanged. */
+typedef struct JSJobContextHooks {
+    /* called once per successfully enqueued job, at enqueue time.
+       returns 0 on success; *job_context may be set to a context or left
+       NULL to indicate "no owner" (the job then runs without hooks).
+       returns -1 to fail the enqueue (fail closed: no identity-less job). */
+    int (*capture)(JSContext *ctx, void *opaque, void **job_context);
+    /* called before job_func; must return the previous context (or NULL)
+       so leave can restore it. */
+    void *(*enter)(JSContext *ctx, void *job_context, void *opaque);
+    /* called after job_func on all return paths; restores previous. */
+    void (*leave)(JSContext *ctx, void *previous_context, void *opaque);
+    /* called once after a job executes, and once per unexecuted job
+       during JS_FreeRuntime. */
+    void (*release)(void *job_context, void *opaque);
+} JSJobContextHooks;
+
+JS_EXTERN void JS_SetJobContextHooks(JSRuntime *rt, const JSJobContextHooks *hooks, void *opaque);
 JS_EXTERN void JS_SetCanBlock(JSRuntime *rt, bool can_block);
 /* set the [IsHTMLDDA] internal slot */
 JS_EXTERN void JS_SetIsHTMLDDA(JSContext *ctx, JSValueConst obj);
