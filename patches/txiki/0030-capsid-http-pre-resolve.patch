+/* Terminate a request that never reached the lws connection machinery
+ * (resolution-phase failures and the last-address connect failure). */
+static void tjs_httpclient_fail_async(TJSHttpClient *h, const char *message) {
+    if (h->dns_results_pending) {
+        uv_freeaddrinfo(h->dns_results_pending);
+        h->dns_results_pending = NULL;
+    }
+    if (h->dns_results) {
+        uv_freeaddrinfo(h->dns_results);
+        h->dns_results = NULL;
+        h->dns_next = NULL;
+    }
+    if (!h->completed) {
+        h->completed = true;
+        JSValue args[2];
+        args[0] = JS_NewString(h->ctx, "CONNECTION_ERROR");
+        args[1] = JS_NewString(h->ctx, message);
+        maybe_invoke_callback(h, HC_CALLBACK_COMPLETE, 2, args);
+        tjs_httpclient_done(h);
+    }
+    CHECK(!JS_IsUndefined(h->this_val));
+    JSValue val = h->this_val;
+    h->this_val = JS_UNDEFINED;
+    JS_FreeValue(h->ctx, val);
+}
+
+/* Release the prevent-GC reference held through a cancelled (aborted or
+ * timed-out) resolution.  The uv_getaddrinfo request cannot be cancelled,
+ * so the reference lives until its callback observes the cancel. */
+static void tjs_httpclient_release_after_resolve(TJSHttpClient *h) {
+    if (h->dns_results_pending) {
+        uv_freeaddrinfo(h->dns_results_pending);
+        h->dns_results_pending = NULL;
+    }
+    if (h->dns_results) {
+        uv_freeaddrinfo(h->dns_results);
+        h->dns_results = NULL;
+        h->dns_next = NULL;
+    }
+    CHECK(!JS_IsUndefined(h->this_val));
+    JSValue val = h->this_val;
+    h->this_val = JS_UNDEFINED;
+    JS_FreeValue(h->ctx, val);
+}
+
+/* Establish an lws connection to `address`.  For pre-resolved targets it
+ * is a numeric address and h->connect_host keeps the Host header and SNI;
+ * for numeric-direct and proxied targets both are the hostname lws hands
+ * over unchanged. */
+static int tjs_httpclient_connect_addr(TJSHttpClient *h, const char *address) {
+    JSContext *ctx = h->ctx;
+
+    struct lws_context *lws_ctx = tjs__lws_get_context(ctx);
+    if (!lws_ctx) {
+        return -1;
+    }
+
+    struct lws_client_connect_info cci;
+    memset(&cci, 0, sizeof(cci));
+
+    cci.context = lws_ctx;
+    cci.address = address;
+    cci.port = h->connect_port;
+    cci.path = h->connect_path;
+    cci.host = h->connect_host;
+    cci.origin = h->connect_host;
+    cci.ssl_connection = (h->connect_ssl ? LCCSCF_USE_SSL : 0) | h->ssl_flags | LCCSCF_HTTP_NO_FOLLOW_REDIRECT;
+    cci.method = h->method;
+    cci.local_protocol_name = TJS_LWS_HTTP_PROTOCOL_NAME;
+    cci.userdata = h;
+    cci.pwsi = &h->wsi;
+    cci.vhost = tjs__lws_select_vhost(ctx, h->connect_ssl ? "https" : "http", h->connect_host, h->connect_port);
+
+    tjs__lws_conn_ref(ctx);
+
+    struct lws *wsi = lws_client_connect_via_info(&cci);
+    if (!wsi) {
+        tjs__lws_conn_unref(ctx);
+        h->wsi = NULL;
+        return -1;
+    }
+
+    lws_cancel_service(lws_ctx);
+
+    if (h->timeout > 0) {
+        lws_set_timer_usecs(wsi, (lws_usec_t) h->timeout * LWS_USEC_PER_SEC / 1000);
+    }
+
+    return 0;
+}
+
+/* Connect to the current address in the pre-resolved list.  On success the
+ * list is consumed; a later CONNECTION_ERROR retries the next entry. */
+static int tjs_httpclient_connect_next(TJSHttpClient *h) {
+    const char *address = NULL;
+    char ip_str[INET6_ADDRSTRLEN];
+
+    if (h->dns_next) {
+        struct addrinfo *ai = h->dns_next;
+        if (ai->ai_family == AF_INET6) {
+            struct sockaddr_in6 *sa6 = (struct sockaddr_in6 *) ai->ai_addr;
+            if (uv_inet_ntop(AF_INET6, &sa6->sin6_addr, ip_str, sizeof(ip_str)) == 0) {
+                address = ip_str;
+            }
+        } else {
+            struct sockaddr_in *sa = (struct sockaddr_in *) ai->ai_addr;
+            if (uv_inet_ntop(AF_INET, &sa->sin_addr, ip_str, sizeof(ip_str)) == 0) {
+                address = ip_str;
+            }
+        }
+    }
+
+    if (!address || tjs_httpclient_connect_addr(h, address)) {
+        return -1;
+    }
+
+    uv_freeaddrinfo(h->dns_results);
+    h->dns_results = NULL;
+    h->dns_next = NULL;
+
+    return 0;
+}
+
+/* Finish the resolution phase once both the uv_getaddrinfo request and the
+ * deadline-timer handle have settled (the timer handle cannot be closed
+ * synchronously, and the request cannot be cancelled). */
+static void tjs_httpclient_continue_resolve(TJSHttpClient *h) {
+    if (h->resolving) {
+        /* the deadline fired first; the still-pending uv_getaddrinfo
+         * callback re-enters here and performs the teardown */
+        return;
+    }
+
+    if (h->resolve_cancelled) {
+        /* abort() or the deadline already reported the terminal state */
+        tjs_httpclient_release_after_resolve(h);
+        return;
+    }
+
+    if (h->dns_status != 0 || !h->dns_results_pending) {
+        tjs_httpclient_fail_async(h, "DNS resolution failed");
+        return;
+    }
+
+    h->dns_results = h->dns_results_pending;
+    h->dns_next = h->dns_results_pending;
+    h->dns_results_pending = NULL;
+
+    if (tjs_httpclient_connect_next(h)) {
+        tjs_httpclient_fail_async(h, "Connection failed");
+    }
+}
+
+static void tjs_httpclient_dns_timer_closed(uv_handle_t *handle) {
+    TJSHttpClient *h = handle->data;
+    tjs_httpclient_continue_resolve(h);
+}
+
+static void tjs_httpclient_dns_timeout(uv_timer_t *timer) {
+    TJSHttpClient *h = timer->data;
+    if (h->resolving) {
+        /* uv_getaddrinfo cannot be cancelled; mark the request terminal and
+         * let the resolve callback release the prevent-GC reference */
+        h->resolve_cancelled = true;
+        if (!h->completed) {
+            h->completed = true;
+            JSValue error = JS_NewString(h->ctx, "TIMED_OUT");
+            maybe_invoke_callback(h, HC_CALLBACK_COMPLETE, 1, &error);
+            tjs_httpclient_done(h);
+        }
+    }
+    if (h->dns_timer_init) {
+        h->dns_timer_init = false;
+        uv_timer_stop(timer);
+        uv_close((uv_handle_t *) timer, tjs_httpclient_dns_timer_closed);
+    }
+}
+
+static void tjs_httpclient_dns_resolved(uv_getaddrinfo_t *req, int status, struct addrinfo *res) {
+    TJSHttpClient *h = req->data;
+    h->resolving = false;
+    h->dns_status = status;
+    h->dns_results_pending = res;
+
+    if (h->dns_timer_init) {
+        h->dns_timer_init = false;
+        uv_timer_stop(&h->dns_timer);
+        uv_close((uv_handle_t *) &h->dns_timer, tjs_httpclient_dns_timer_closed);
+    } else {
+        tjs_httpclient_continue_resolve(h);
+    }
+}
+
+/* Begin system-resolver pre-resolution for the target hostname. */
+static int tjs_httpclient_resolve(TJSHttpClient *h) {
+    struct addrinfo hints;
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_flags = AI_ADDRCONFIG | AI_V4MAPPED;
+
+    h->resolving = true;
+    h->dns_req.data = h;
+    h->dns_timer.data = h;
+    uv_loop_t *loop = TJS_GetLoop(h->qrt);
+    int r = uv_getaddrinfo(loop, &h->dns_req, tjs_httpclient_dns_resolved, h->connect_host, NULL, &hints);
+    if (r) {
+        /* validation failure: no callback will ever fire */
+        h->resolving = false;
+        return -1;
+    }
+
+    if (h->timeout > 0) {
+        uv_timer_init(loop, &h->dns_timer);
+        h->dns_timer_init = true;
+        uv_timer_start(&h->dns_timer, tjs_httpclient_dns_timeout, h->timeout, 0);
+    }
+
+    return 0;
+}
