+/* Capsid: true when the selected client vhost for this URL is a proxy
+ * vhost.  A proxy owns name resolution, so the fetch engine must not
+ * pre-resolve the target when one applies. */
+bool tjs__lws_uses_proxy(JSContext *ctx, const char *scheme, const char *hostname, int port) {
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    CHECK_NOT_NULL(qrt);
+    return tjs__lws_select_vhost(ctx, scheme, hostname, port) != qrt->lws.vh_direct;
+}
