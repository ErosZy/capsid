 EXT_DEF(1, reserved_array_get_r0, 0, 0, 0, none)
+#ifdef CONFIG_EXT_FUSION34
+/* Experimental fusion templates: id 2 fuses two loc reads +
+   get_array_el (payload: object slot, index slot); id 3 fuses three
+   loc reads + get_array_el (payload: leftover slot, object slot,
+   index slot). Each slot byte is tagged: bit 7 = argument buffer
+   (arg_buf, args and locals live in separate stores), low 7 bits =
+   index. Sizes include OP_ext + ext_id + payload. */
+EXT_DEF(2, loc_loc_array_get, 4, 0, 1, slot2)
+EXT_DEF(3, loc_loc_loc_array_get, 5, 0, 2, slot3)
+#endif
