+#ifdef CONFIG_EXT_FUSION34
+/* Validate frame-slot operands once while loading BC27. The interpreter can
+   then keep the fused dispatch path as direct arg/local array accesses. */
+static bool ext_opcode_operands_valid(const JSFunctionBytecode *b,
+                                      const uint8_t *insn,
+                                      const JSExtOpcodeInfo *ei)
+{
+    int i, slot_count;
+
+    switch (ei->fmt) {
+    case EXT_FMT_none:
+        return ei->size == 2;
+    case EXT_FMT_slot2:
+        slot_count = 2;
+        break;
+    case EXT_FMT_slot3:
+        slot_count = 3;
+        break;
+    default:
+        return false;
+    }
+    if (ei->size != 2 + slot_count)
+        return false;
+    for (i = 0; i < slot_count; i++) {
+        uint8_t slot = insn[2 + i];
+        unsigned int limit = (slot & 0x80) ? b->arg_count : b->var_count;
+        if ((slot & 0x7f) >= limit)
+            return false;
+    }
+    return true;
+}
+#endif
