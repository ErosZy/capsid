--- a/src/httpclient.c
+++ b/src/httpclient.c
@@ -1421,13 +1421,13 @@
             maybe_invoke_callback(h, HC_CALLBACK_COMPLETE, 1, &error);
             tjs_httpclient_done(h);
 
-            /* Mark the wsi to be killed at the next timeout check.  abort()
-             * is reachable from inside a lws callback for this very wsi (JS
-             * reads the response body, which runs under
-             * RECEIVE_CLIENT_HTTP_READ, and aborts from there).  A synchronous
-             * kill frees the wsi while lws is still servicing it, and lws
