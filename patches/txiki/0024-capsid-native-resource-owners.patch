+void tjs_set_resource_owner_hooks(JSContext *ctx, const TJSResourceOwnerHooks *hooks, void *opaque) {
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    CHECK_NOT_NULL(qrt);
+    if (hooks) {
+        qrt->resource_owner_hooks = *hooks;
+    } else {
+        memset(&qrt->resource_owner_hooks, 0, sizeof(qrt->resource_owner_hooks));
+    }
+    qrt->resource_owner_opaque = opaque;
+}
+
+int tjs_capture_resource_owner(JSContext *ctx, void **out_owner) {
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    *out_owner = NULL;
+    if (!qrt->resource_owner_hooks.capture) {
+        return 0;
+    }
+    if (qrt->resource_owner_hooks.capture(ctx, qrt->resource_owner_opaque, out_owner) < 0 || !*out_owner) {
+        JS_ThrowTypeError(ctx, "CAPSID_BINDING_OWNER_UNAVAILABLE");
+        return -1;
+    }
+    return 0;
+}
+
+int tjs_require_resource_owner(JSContext *ctx, void *owner) {
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    if (!qrt->resource_owner_hooks.authorize) {
+        return 0;
+    }
+    if (!owner || !qrt->resource_owner_hooks.authorize(ctx, owner, qrt->resource_owner_opaque)) {
+        JS_ThrowTypeError(ctx, "CAPSID_BINDING_OWNER_MISMATCH");
+        return -1;
+    }
+    return 0;
+}
+
+void tjs_release_resource_owner(JSContext *ctx, void *owner) {
+    if (!owner) {
+        return;
+    }
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    if (qrt->resource_owner_hooks.release) {
+        qrt->resource_owner_hooks.release(owner, qrt->resource_owner_opaque);
+    }
+}
+
+void tjs_release_resource_owner_rt(JSRuntime *rt, void *owner) {
+    if (!owner) {
+        return;
+    }
+    TJSRuntime *qrt = JS_GetRuntimeOpaque(rt);
+    if (qrt && qrt->resource_owner_hooks.release) {
+        qrt->resource_owner_hooks.release(owner, qrt->resource_owner_opaque);
+    }
+}
+
+#ifdef TJS_RESTRICTED_CORE
+bool tjs_check_fs_access(JSContext *ctx, const char *path, int access_kind) {
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    if (!qrt || !qrt->capsid_fs.check) {
+        JS_ThrowTypeError(ctx, "fs policy is unavailable");
+        return false;
+    }
+    char reason[TJS_EGRESS_REASON_MAX] = { 0 };
+    if (!qrt->capsid_fs.check(qrt->capsid_fs.opaque, path, access_kind,
+                              reason, sizeof(reason))) {
+        JS_ThrowTypeError(ctx, "%s",
+                          reason[0] ? reason : "fs access denied");
+        return false;
+    }
+    return true;
+}
+#endif
