+#ifdef CONFIG_FIELD_IC
+/* BC26 remains canonical. A hot function owns a one-byte direct map indexed
+   by the original instruction PC; only hot sites consume one of eight fixed
+   MONO/POLY2 entries. The hit path never mutates bytecode or cache state. */
+static no_inline JSFieldICFunction *js_field_ic_function_new(
+    JSContext *ctx, JSFunctionBytecode *b)
+{
+    JSRuntime *rt = ctx->rt;
+    JSFieldICFunction *fs;
+    size_t alloc_size;
+
+    if (b->byte_code_len <= 0)
+        return NULL;
+    alloc_size = offsetof(JSFieldICFunction, site_map) +
+                 (size_t)b->byte_code_len;
+    if (alloc_size > rt->field_ic_budget_remaining) {
+        rt->field_ic_budget_denials++;
+        return NULL;
+    }
+    fs = js_mallocz(ctx, alloc_size);
+    if (!fs) {
+        rt->field_ic_budget_denials++;
+        return NULL;
+    }
+    fs->alloc_size = alloc_size;
+    b->field_ic = fs;
+    rt->field_ic_budget_remaining -= alloc_size;
+    rt->field_ic_sidecars++;
+    return fs;
+}
+
+static void js_field_ic_function_free(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    JSFieldICFunction *fs = b->field_ic;
+
+    if (!fs)
+        return;
+    assert(fs->alloc_size <= JS_FIELD_IC_BUDGET_BYTES -
+                             rt->field_ic_budget_remaining);
+    rt->field_ic_budget_remaining += fs->alloc_size;
+    assert(rt->field_ic_sidecars != 0);
+    rt->field_ic_sidecars--;
+    b->field_ic = NULL;
+    js_free_rt(rt, fs);
+}
+
+static inline bool js_field_ic_get(JSRuntime *rt, JSFunctionBytecode *b,
+                                   const uint8_t *pc, JSValueConst obj,
+                                   JSValue *pval)
+{
+    JSFieldICFunction *fs = b->field_ic;
+    JSFieldICEntry *entry;
+    JSObject *p;
+    uint32_t off, shape_id, prop_offset;
+    uint8_t token;
+
+    if (unlikely(!fs || rt->shape_identity_disabled ||
+                 JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT))
+        return false;
+    off = (uint32_t)(pc - b->byte_code_buf);
+    if (unlikely(off >= (uint32_t)b->byte_code_len))
+        return false;
+    token = fs->site_map[off];
+    if (likely(token >= JS_FIELD_IC_SLOT_BASE &&
+               token < JS_FIELD_IC_DISABLED)) {
+        uint32_t sid = token - JS_FIELD_IC_SLOT_BASE;
+        if (unlikely(sid >= fs->site_count))
+            return false;
+        entry = &fs->sites[sid];
+        p = JS_VALUE_GET_OBJ(obj);
+        shape_id = p->shape->shape_identity_id;
+        if (likely(shape_id == entry->shape_id[0])) {
+            prop_offset = entry->prop_offset[0];
+        } else if (entry->state == JS_FIELD_IC_POLY2 &&
+                   shape_id == entry->shape_id[1]) {
+            prop_offset = entry->prop_offset[1];
+        } else {
+            return false;
+        }
+        if (unlikely(prop_offset >= (uint32_t)p->shape->prop_count))
+            return false;
+        *pval = js_dup(p->prop[prop_offset].u.value);
+        return true;
+    }
+    return false;
+}
+
+static no_inline void js_field_ic_observe(JSContext *ctx,
+                                          JSFunctionBytecode *b,
+                                          const uint8_t *pc,
+                                          JSValueConst obj,
+                                          bool cacheable,
+                                          uint32_t prop_offset)
+{
+    JSRuntime *rt = ctx->rt;
+    JSFieldICFunction *fs;
+    JSFieldICEntry *entry;
+    uint32_t off, shape_id;
+    uint8_t token;
+
+    if (unlikely(b->field_ic_denied || rt->shape_identity_disabled))
+        return;
+    fs = b->field_ic;
+    if (!fs) {
+        if (++b->field_ic_hot_count < JS_FIELD_IC_FUNCTION_HOT)
+            return;
+        fs = js_field_ic_function_new(ctx, b);
+        if (!fs) {
+            b->field_ic_denied = 1;
+            return;
+        }
+    }
+    off = (uint32_t)(pc - b->byte_code_buf);
+    if (unlikely(off >= (uint32_t)b->byte_code_len))
+        return;
+    token = fs->site_map[off];
+    if (token == JS_FIELD_IC_DISABLED)
+        return;
+    if (token < JS_FIELD_IC_SLOT_BASE) {
+        if (token + 1 < JS_FIELD_IC_SITE_HOT) {
+            fs->site_map[off] = token + 1;
+            return;
+        }
+        if (!cacheable || JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT ||
+            fs->site_count >= JS_FIELD_IC_MAX_SITES) {
+            fs->site_map[off] = JS_FIELD_IC_DISABLED;
+            return;
+        }
+        shape_id = JS_VALUE_GET_OBJ(obj)->shape->shape_identity_id;
+        if (unlikely(shape_id == 0)) {
+            fs->site_map[off] = JS_FIELD_IC_DISABLED;
+            return;
+        }
+        token = JS_FIELD_IC_SLOT_BASE + fs->site_count++;
+        fs->site_map[off] = token;
+        entry = &fs->sites[token - JS_FIELD_IC_SLOT_BASE];
+        entry->shape_id[0] = shape_id;
+        entry->prop_offset[0] = prop_offset;
+        entry->state = JS_FIELD_IC_MONO;
+        rt->field_ic_sites++;
+        rt->field_ic_mono++;
+        return;
+    }
+
+    entry = &fs->sites[token - JS_FIELD_IC_SLOT_BASE];
+    if (!cacheable || JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT) {
+        if (++entry->miss_streak < JS_FIELD_IC_MAX_MISSES)
+            return;
+        fs->site_map[off] = JS_FIELD_IC_DISABLED;
+        rt->field_ic_megamorphic++;
+        return;
+    }
+    shape_id = JS_VALUE_GET_OBJ(obj)->shape->shape_identity_id;
+    if (shape_id == entry->shape_id[0] &&
+        prop_offset == entry->prop_offset[0]) {
+        entry->miss_streak = 0;
+        return;
+    }
+    if (entry->state == JS_FIELD_IC_POLY2 &&
+        shape_id == entry->shape_id[1] &&
+        prop_offset == entry->prop_offset[1]) {
+        entry->miss_streak = 0;
+        return;
+    }
+    if (entry->state == JS_FIELD_IC_MONO && shape_id != 0) {
+        entry->shape_id[1] = shape_id;
+        entry->prop_offset[1] = prop_offset;
+        entry->state = JS_FIELD_IC_POLY2;
+        entry->miss_streak = 0;
+        rt->field_ic_poly2++;
+        return;
+    }
+    fs->site_map[off] = JS_FIELD_IC_DISABLED;
+    rt->field_ic_megamorphic++;
+}
+
+void JS_GetFieldICReport(JSRuntime *rt, JSFieldICReport *out)
+{
+    memset(out, 0, sizeof(*out));
+    out->current_bytes = JS_FIELD_IC_BUDGET_BYTES -
+                         rt->field_ic_budget_remaining;
+    out->current_sidecars = rt->field_ic_sidecars;
+    out->selected_sites = rt->field_ic_sites;
+    out->mono_sites = rt->field_ic_mono;
+    out->poly2_sites = rt->field_ic_poly2;
+    out->megamorphic_sites = rt->field_ic_megamorphic;
+    out->budget_denials = rt->field_ic_budget_denials;
+}
+
+void JS_FieldICSetShapeCounterForTest(JSRuntime *rt, uint32_t value)
+{
+    rt->shape_identity_id = value;
+    rt->shape_identity_disabled = false;
+}
