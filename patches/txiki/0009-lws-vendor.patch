+int
+lws_hdr_custom_value_foreach(struct lws *wsi,
+			     lws_hdr_custom_value_fe_cb_t cb, void *custom)
+{
+	ah_data_idx_t ll;
+
+	if (!wsi->http.ah)
+		return -1;
+
+	ll = wsi->http.ah->unk_ll_head;
+
+	while (ll) {
+		int nlen, vlen;
+
+		if (ll >= wsi->http.ah->data_length)
+			return -1;
+
+		nlen = lws_ser_ru16be((uint8_t *)&wsi->http.ah->data[ll + UHO_NLEN]);
+		vlen = lws_ser_ru16be((uint8_t *)&wsi->http.ah->data[ll + UHO_VLEN]);
+		cb(&wsi->http.ah->data[ll + UHO_NAME], nlen,
+		   &wsi->http.ah->data[ll + UHO_NAME + (unsigned int)nlen],
+		   vlen, custom);
+
+		ll = lws_ser_ru32be((uint8_t *)&wsi->http.ah->data[ll + UHO_LL]);
+	}
+
+	return 0;
+}
