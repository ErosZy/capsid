 int
+lws_get_connect_peer_address(struct lws *wsi,
+			     struct sockaddr_storage *address,
+			     socklen_t *address_len)
+{
+	socklen_t needed;
+
+	if (!wsi || !address || !address_len)
+		return 1;
+
+	wsi = lws_get_network_wsi(wsi);
+	if (!wsi)
+		return 1;
+
+	if (wsi->sa46_peer.sa4.sin_family == AF_INET)
+		needed = (socklen_t)sizeof(struct sockaddr_in);
+#if defined(LWS_WITH_IPV6)
+	else if (wsi->sa46_peer.sa6.sin6_family == AF_INET6)
+		needed = (socklen_t)sizeof(struct sockaddr_in6);
+#endif
+	else
+		return 1;
+
+	if (*address_len < needed)
+		return 1;
+	memcpy(address, &wsi->sa46_peer, needed);
+	*address_len = needed;
+	return 0;
+}
