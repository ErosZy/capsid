 void tjs_call_handler(JSContext *ctx, JSValue func, int argc, JSValue *argv);
+
+/* async context hooks: mirror JSJobContextHooks (deps/quickjs) at the txiki
+   layer, so native resources (timers, httpclient, webcrypto ops) can capture
+   and re-enter the owning async context across libuv callbacks. Not
+   installed -> upstream behavior unchanged. */
+typedef struct TJSAsyncContextHooks {
+    /* called when a native resource captures the current context. *out may
+       be set to a context or left NULL ("no owner"). returns -1 to fail. */
+    int (*capture)(JSContext *ctx, void *opaque, void **out_ctx_data);
+    /* called before running a callback owned by ctx_data; must return the
+       previous context (or NULL) so leave can restore it. */
+    void *(*enter)(JSContext *ctx, void *ctx_data, void *opaque);
+    /* called after the callback on all return paths; restores previous. */
+    void (*leave)(JSContext *ctx, void *previous_context, void *opaque);
+    /* called once when the resource no longer holds the context. */
+    void (*release)(void *ctx_data, void *opaque);
+} TJSAsyncContextHooks;
+
+void tjs_set_async_context_hooks(JSContext *ctx, const TJSAsyncContextHooks *hooks, void *opaque);
+int tjs_capture_ctx(JSContext *ctx, void **out_ctx_data);
+void tjs_enter_ctx(JSContext *ctx, void *ctx_data, void **prev);
+void tjs_leave_ctx(JSContext *ctx, void **prev);
+void tjs_release_ctx(JSContext *ctx, void *ctx_data);
+void tjs_call_handler_ctx(JSContext *ctx, void *ctx_data, JSValue func, int argc, JSValue *argv);
 void tjs_dump_error(JSContext *ctx);
 void tjs_dump_error1(JSContext *ctx, JSValue exception_val);
 
 typedef struct {
     JSValue p;
     JSValue rfuncs[2];
+    void *ctx_data; /* captured async context, released in TJS_ClearPromise */
 } TJSPromise;
 
 JSValue TJS_InitPromise(JSContext *ctx, TJSPromise *p);
