+void tjs_set_async_context_hooks(JSContext *ctx, const TJSAsyncContextHooks *hooks, void *opaque) {
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    CHECK_NOT_NULL(qrt);
+    if (hooks) {
+        qrt->async_ctx_hooks = *hooks;
+    } else {
+        memset(&qrt->async_ctx_hooks, 0, sizeof(qrt->async_ctx_hooks));
+    }
+    qrt->async_ctx_opaque = opaque;
+}
+
+int tjs_capture_ctx(JSContext *ctx, void **out_ctx_data) {
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    *out_ctx_data = NULL;
+    if (qrt->async_ctx_hooks.capture) {
+        return qrt->async_ctx_hooks.capture(ctx, qrt->async_ctx_opaque, out_ctx_data);
+    }
+    return 0;
+}
+
+void tjs_enter_ctx(JSContext *ctx, void *ctx_data, void **prev) {
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    *prev = NULL;
+    if (ctx_data && qrt->async_ctx_hooks.enter) {
+        *prev = qrt->async_ctx_hooks.enter(ctx, ctx_data, qrt->async_ctx_opaque);
+    }
+}
+
+void tjs_leave_ctx(JSContext *ctx, void **prev) {
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    if (qrt->async_ctx_hooks.leave) {
+        qrt->async_ctx_hooks.leave(ctx, *prev, qrt->async_ctx_opaque);
+    }
+}
+
+void tjs_release_ctx(JSContext *ctx, void *ctx_data) {
+    if (!ctx_data) {
+        return;
+    }
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    if (qrt->async_ctx_hooks.release) {
+        qrt->async_ctx_hooks.release(ctx_data, qrt->async_ctx_opaque);
+    }
+}
+
+void tjs_call_handler_ctx(JSContext *ctx, void *ctx_data, JSValue func, int argc, JSValue *argv) {
+    if (!ctx_data) {
+        tjs_call_handler(ctx, func, argc, argv);
+        return;
+    }
+    void *prev = NULL;
+    tjs_enter_ctx(ctx, ctx_data, &prev);
+    tjs_call_handler(ctx, func, argc, argv);
+    tjs_leave_ctx(ctx, &prev);
+}
+
 JSValue TJS_InitPromise(JSContext *ctx, TJSPromise *p) {
+    p->ctx_data = NULL;
     p->p = JS_NewPromiseCapability(ctx, p->rfuncs);
     if (JS_IsException(p->p)) {
         return JS_EXCEPTION;
     }
+    if (tjs_capture_ctx(ctx, &p->ctx_data) < 0) {
+        JS_FreeValue(ctx, p->p);
+        JS_FreeValue(ctx, p->rfuncs[0]);
+        JS_FreeValue(ctx, p->rfuncs[1]);
+        p->p = JS_UNDEFINED;
+        p->rfuncs[0] = JS_UNDEFINED;
+        p->rfuncs[1] = JS_UNDEFINED;
+        return JS_EXCEPTION;
+    }
     return JS_DupValue(ctx, p->p);
 }
 
 void TJS_ClearPromise(JSContext *ctx, TJSPromise *p) {
+    tjs_release_ctx(ctx, p->ctx_data);
+    p->ctx_data = NULL;
     p->p = JS_UNDEFINED;
     p->rfuncs[0] = JS_UNDEFINED;
     p->rfuncs[1] = JS_UNDEFINED;
 }
 
 void TJS_SettlePromise(JSContext *ctx, TJSPromise *p, bool is_reject, JSValue arg) {
+    /* enter the owning async context so reaction jobs enqueued by the
+       settle call capture it (native callbacks run outside JS) */
+    void *prev = NULL;
+    tjs_enter_ctx(ctx, p->ctx_data, &prev);
     JSValue ret = JS_Call(ctx, p->rfuncs[is_reject], JS_UNDEFINED, 1, &arg);
+    tjs_leave_ctx(ctx, &prev);
     JS_FreeValue(ctx, arg);
     JS_FreeValue(ctx, ret); /* XXX: what to do if exception ? */
     JS_FreeValue(ctx, p->rfuncs[0]);
