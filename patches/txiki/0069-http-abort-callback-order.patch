 /* Wire EOF may precede application consumption. Retire the socket at wire
  * EOF, but keep the captured owner/context until buffered decoding finishes. */
-static void tjs_httpclient_finish_decoding(TJSHttpClient *h) {
+static void tjs_httpclient_finish_decoding(TJSHttpClient *h, bool synchronous_abort) {
     if (h->completed || h->input_head || (!h->wire_complete && !h->signal_aborted)) return;
     if (h->signal_aborted) {
         h->completed = true;
         JSValue error = JS_NewString(h->ctx, "ABORTED_BUFFERED");
-        maybe_invoke_callback(h, HC_CALLBACK_COMPLETE, 1, &error);
+        if (synchronous_abort) {
+            /* abort() is still on the caller's JS stack. As with ordinary
+             * cancellation, preserve its owner without running promise jobs
+             * before the signal dispatch and the caller have returned. */
+            JSValue callback = h->callbacks[HC_CALLBACK_COMPLETE];
+            if (!h->context_cancelled && !h->qrt->freeing && JS_IsFunction(h->ctx, callback))
