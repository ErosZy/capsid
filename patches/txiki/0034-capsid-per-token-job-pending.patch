+bool JS_IsJobPendingWithContext(JSRuntime *rt, void *job_context)
+{
+    struct list_head *el;
+
+    if (!job_context)
+        return false;
+    list_for_each(el, &rt->job_list) {
+        if (list_entry(el, JSJobEntry, link)->job_ctx == job_context)
+            return true;
+    }
+    return false;
+}
