+static JSValue tjs_http_gzip_decoder_step(JSContext *ctx, JSValue this_val, int argc, JSValue *argv) {
+    TJSHttpGzip *decoder = JS_GetOpaque2(ctx, this_val, tjs_http_gzip_decoder_class_id);
+    if (!decoder) return JS_EXCEPTION;
+    if (argc < 4) return JS_ThrowTypeError(ctx, "Expected encoded buffer, offset, length and output capacity");
+    int64_t offset, length, capacity;
+    if (JS_ToInt64(ctx, &offset, argv[1]) || JS_ToInt64(ctx, &length, argv[2]) || JS_ToInt64(ctx, &capacity, argv[3]))
+        return JS_EXCEPTION;
+    if (offset < 0 || length < 0 || capacity < 1 || capacity > 4096)
+        return JS_ThrowRangeError(ctx, "Invalid encoded decoder bounds");
+    static const uint8_t empty = 0;
+    size_t size = 0;
+    const uint8_t *bytes = &empty;
+    if (!JS_IsNull(argv[0])) {
+        bytes = JS_GetArrayBuffer(ctx, &size, argv[0]);
+        if (!bytes) return JS_EXCEPTION;
+    }
+    if ((uint64_t) offset > size || (uint64_t) length > size - (size_t) offset)
+        return JS_ThrowRangeError(ctx, "Encoded decoder input exceeds buffer");
+    TBuf out;
+    tbuf_init(ctx, &out);
+    size_t consumed = 0;
+    int status = http_gzip_step_capacity(decoder, bytes + (size_t) offset, (size_t) length,
+        &consumed, &out, (size_t) capacity);
+    if (status < 0) {
+        tbuf_free(&out);
+        return JS_ThrowTypeError(ctx, "Gzip decompression failed.");
+    }
+    JSValue result = JS_NewObject(ctx);
+    if (JS_IsException(result)) {tbuf_free(&out); return result;}
+    JSValue data = JS_NewArrayBufferCopy(ctx, out.buf, out.size);
+    tbuf_free(&out);
+    if (JS_IsException(data)) {JS_FreeValue(ctx, result); return data;}
+    if (JS_SetPropertyStr(ctx, result, "data", data) < 0
+        || JS_SetPropertyStr(ctx, result, "consumed", JS_NewInt64(ctx, (int64_t) consumed)) < 0
+        || JS_SetPropertyStr(ctx, result, "status", JS_NewInt32(ctx, status)) < 0
+        || JS_SetPropertyStr(ctx, result, "atMemberEnd", JS_NewBool(ctx, decoder->state == HTTP_GZIP_DONE)) < 0) {
+        JS_FreeValue(ctx, result); return JS_EXCEPTION;
+    }
+    return result;
+}
+
+static JSValue tjs_http_gzip_decoder_finish(JSContext *ctx, JSValue this_val, int argc, JSValue *argv) {
+    (void) argc; (void) argv;
+    TJSHttpGzip *decoder = JS_GetOpaque2(ctx, this_val, tjs_http_gzip_decoder_class_id);
+    if (!decoder) return JS_EXCEPTION;
