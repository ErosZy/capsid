+static void tjs_http_gzip_decoder_finalizer(JSRuntime *rt, JSValue value) {
+    TJSHttpGzip *decoder = JS_GetOpaque(value, tjs_http_gzip_decoder_class_id);
+    if (decoder) http_gzip_destroy(decoder, rt);
