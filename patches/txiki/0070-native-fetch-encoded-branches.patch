+    return JS_UNDEFINED;
+}
+
+static JSValue tjs_http_gzip_decoder_dispose(JSContext *ctx, JSValue this_val, int argc, JSValue *argv) {
+    (void) argc; (void) argv;
+    TJSHttpGzip *decoder = JS_GetOpaque2(ctx, this_val, tjs_http_gzip_decoder_class_id);
+    if (!decoder) return JS_EXCEPTION;
+    JS_SetOpaque(this_val, NULL);
+    http_gzip_destroy(decoder, JS_GetRuntime(ctx));
+    return JS_UNDEFINED;
+}
+
+static JSValue tjs_httpclient_create_gzip_decoder(JSContext *ctx, JSValue this_val, int argc, JSValue *argv) {
+    (void) argc; (void) argv;
+    if (!tjs_httpclient_get(ctx, this_val)) return JS_EXCEPTION;
+    TJSHttpGzip *decoder = http_gzip_create(ctx);
+    if (!decoder) return JS_EXCEPTION;
+    JSValue value = JS_NewObjectClass(ctx, tjs_http_gzip_decoder_class_id);
+    if (JS_IsException(value)) {http_gzip_destroy(decoder, JS_GetRuntime(ctx)); return value;}
+    JS_SetOpaque(value, decoder);
+    return value;
+}
