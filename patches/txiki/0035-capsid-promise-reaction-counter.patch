+static JSJobContextUse *job_ctx_use_find(JSRuntime *rt, void *ctx_data)
+{
+    JSJobContextUse *u;
+    for(u = rt->job_ctx_uses; u != NULL; u = u->next) {
+        if (u->ctx_data == ctx_data)
+            return u;
+    }
+    return NULL;
+}
+
+static void job_ctx_use_inc(JSRuntime *rt, void *ctx_data)
+{
+    JSJobContextUse *u;
+    if (ctx_data == NULL)
+        return;
+    u = job_ctx_use_find(rt, ctx_data);
+    if (u == NULL) {
+        u = js_malloc_rt(rt, sizeof(*u));
+        if (u == NULL)
+            return;
+        u->next = rt->job_ctx_uses;
+        u->ctx_data = ctx_data;
+        u->reactions = 0;
+        rt->job_ctx_uses = u;
+    }
+    u->reactions++;
+}
+
+static void job_ctx_use_dec(JSRuntime *rt, void *ctx_data)
+{
+    JSJobContextUse **pp, *u;
+    if (ctx_data == NULL)
+        return;
+    pp = &rt->job_ctx_uses;
+    while (*pp != NULL) {
+        u = *pp;
+        if (u->ctx_data == ctx_data) {
+            if (--u->reactions <= 0) {
+                *pp = u->next;
+                js_free_rt(rt, u);
+            }
+            return;
+        }
+        pp = &u->next;
+    }
+}
+
+int JS_CountPromiseReactionsWithContext(JSRuntime *rt, void *ctx_data)
+{
+    JSJobContextUse *u = job_ctx_use_find(rt, ctx_data);
+    return u != NULL ? u->reactions : 0;
+}
