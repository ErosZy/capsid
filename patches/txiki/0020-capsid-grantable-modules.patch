--- a/src/modules.c
+++ b/src/modules.c
@@ -139,16 +139,39 @@
 
 JSModuleDef *tjs_module_loader(JSContext *ctx, const char *module_name, void *opaque, JSValueConst attributes) {
 #ifdef TJS_RESTRICTED_CORE
+    /* Binding v1 §3.3: the grantable module set is fixed by this build —
+     * pure tools plus the gated client/resource modules. Importing a
+     * module never grants its native operations, which stay behind the
+     * per-origin policy gates. test_binding_grantable_modules_exist
+     * (CI) locks this exact set, so it cannot drift from the build. */
+    static const char *const tjs_grantable_modules[] = {
+        "tjs:assert",
+        "tjs:getopts",
+        "tjs:hashing",
+        "tjs:internal/core",
+        "tjs:internal/path",
+        "tjs:ipaddr",
+        "tjs:path",
+        "tjs:posix-socket",
+        "tjs:readline",
+        "tjs:sqlite",
+        "tjs:utils",
+        "tjs:uuid",
+        "tjs:wasi",
+        NULL,
+    };
     if (strcmp(module_name, "tjs:internal/core") == 0) {
         TJSRuntime *qrt = TJS_GetRuntime(ctx);
         CHECK_NOT_NULL(qrt);
         return create_default_module(ctx, module_name, JS_DupValue(ctx, qrt->builtins.internal_core));
     }
-#ifdef TJS_BENCHMARK_SQLITE_ONLY
-    if (strcmp(module_name, "tjs:sqlite") == 0) {
-        return tjs__load_builtin(ctx, module_name);
+    for (size_t i = 0; tjs_grantable_modules[i] != NULL; i++) {
+        if (strcmp(module_name, tjs_grantable_modules[i]) == 0) {
+            /* The bundle exists only when its feature flag is on (sqlite,
+             * wasi); a missing bundle fails closed. */
+            return tjs__load_builtin(ctx, module_name);
+        }
     }
-#endif
     JS_ThrowReferenceError(ctx, "module '%s' is not available in the restricted runtime", module_name);
     return NULL;
 #else
