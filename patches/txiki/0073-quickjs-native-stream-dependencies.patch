+/* A suspended result retains the caller identities already subscribed to it.
+   Only the existing private stream observation designates this dependency. */
+static int js_inherit_passive_async_await(JSContext *ctx, JSValueConst awaited,
+                                         JSValueConst resolver)
+{
+    JSPromiseData *input = JS_GetOpaque(awaited, JS_CLASS_PROMISE);
+    if (!input || input->promise_state != JS_PROMISE_PENDING || !input->passive_reactions)
+        return 0;
+    if (!JS_IsObject(resolver) || JS_VALUE_GET_OBJ(resolver)->class_id != JS_CLASS_PROMISE_RESOLVE_FUNCTION)
+        return 0;
+    JSPromiseFunctionData *capability = JS_VALUE_GET_OBJ(resolver)->u.promise_function_data;
+    JSPromiseData *result = JS_GetOpaque(capability->promise, JS_CLASS_PROMISE);
+    if (result && result->promise_state == JS_PROMISE_PENDING)
+        return JS_MarkPromiseReactionsPassive(ctx, capability->promise);
+    return 0;
+}
+
 int JS_MarkPromiseReactionsPassive(JSContext *ctx, JSValueConst promise)
 {
     JSPromiseData *s = JS_GetOpaque2(ctx, promise, JS_CLASS_PROMISE);
+    JSRuntime *rt = ctx->rt;
+    struct list_head *entry;
+    int i;
     if (!s)
         return -1;
     s->passive_reactions = true;
+    if (!rt->promise_ctx_hooks.capture || !rt->promise_ctx_hooks.release ||
+        !rt->job_ctx_hooks.enter || !rt->job_ctx_hooks.leave || !rt->job_ctx_hooks.release)
+        return 0;
+    /* An async prelude can publish its result before reaching the native
+       stream wait. Convert existing parked subscriptions under each original
+       subscriber context, never under the context performing this update. */
+    for (i = 0; i < 2; ++i) {
+        list_for_each(entry, &s->promise_reactions[i]) {
+            JSPromiseReactionData *reaction = list_entry(entry, JSPromiseReactionData, link);
+            void *observer = NULL;
+            void *previous;
+            void *captured;
+            int status;
+            if (unlikely(js_poll_interrupts(ctx)))
+                return -1;
+            if (!reaction->ctx_data || reaction->observer_origin)
+                continue;
+            previous = rt->job_ctx_hooks.enter(ctx, reaction->ctx_data, rt->job_ctx_opaque);
+            status = rt->promise_ctx_hooks.capture(ctx, rt->promise_ctx_opaque, &observer);
+            rt->job_ctx_hooks.leave(ctx, previous, rt->job_ctx_opaque);
+            if (status < 0) {
+                if (observer)
+                    rt->promise_ctx_hooks.release(observer, rt->promise_ctx_opaque);
+                return -1;
+            }
+            if (!observer)
+                continue;
+            captured = reaction->ctx_data;
+            reaction->ctx_data = NULL;
+            reaction->observer_origin = observer;
+            rt->job_ctx_hooks.release(captured, rt->job_ctx_opaque);
+        }
+    }
     return 0;
 }
 
