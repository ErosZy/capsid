+/* Native resolving functions and aggregate element handlers are actual
+   engine forwarding edges. Arbitrary user callbacks, overridden then methods,
+   and unrelated pending promises receive no observation designation here. */
+static int js_mark_native_forwarding_handler_passive(JSContext *ctx, JSValueConst handler)
+{
+    JSObject *object;
+    JSPromiseFunctionData *capability;
+    JSPromiseData *target;
+    if (!JS_IsObject(handler))
+        return 0;
+    object = JS_VALUE_GET_OBJ(handler);
+    if (object->class_id == JS_CLASS_C_FUNCTION_DATA) {
+        JSCFunctionDataRecord *data = JS_GetOpaque(handler, JS_CLASS_C_FUNCTION_DATA);
+        if (!data || data->func != js_promise_all_resolve_element || data->data_len < 5)
+            return 0;
+        handler = data->data[3];
+        if (!JS_IsObject(handler))
+            return 0;
+        object = JS_VALUE_GET_OBJ(handler);
+    }
+    if (object->class_id != JS_CLASS_PROMISE_RESOLVE_FUNCTION &&
+        object->class_id != JS_CLASS_PROMISE_REJECT_FUNCTION)
+        return 0;
+    capability = object->u.promise_function_data;
+    target = JS_GetOpaque(capability->promise, JS_CLASS_PROMISE);
+    if (target && target->promise_state == JS_PROMISE_PENDING)
+        return JS_MarkPromiseReactionsPassive(ctx, capability->promise);
+    return 0;
+}
