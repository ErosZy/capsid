+#ifndef TJS_RESTRICTED_CORE
 /* Convert a non-negative integer fd from JS into a raw host handle for WAMR.
  * Returns true on success; *handle is set to -1 to mean "use the embedder's
  * default stdio" when js_fd is undefined (WAMR reads that as STDIN_FILENO/etc.
@@ -645,6 +646,46 @@ static bool tjs__wasi_fd_to_handle(JSContext *ctx, JSValue js_fd, int64_t *hand
     return true;
 }
+#endif
 
+#ifdef TJS_RESTRICTED_CORE
+/* Binding WASI may only attach its corresponding conventional stdio fd, and
+ * only when the current Binding policy grants that exact stream. Undefined
+ * maps to Capsid's private -2 sentinel, which the WAMR patch below leaves
+ * absent from the guest fd table instead of falling back to host stdio. */
+static bool tjs__wasi_restricted_stdio(JSContext *ctx, JSValue js_fd,
+                                       const char *stream, int expected_fd,
+                                       int64_t *handle) {
+    if (JS_IsUndefined(js_fd)) {
+        *handle = -2;
+        return true;
+    }
+    int32_t fd;
+    if (JS_ToInt32(ctx, &fd, js_fd)) {
+        return false;
+    }
+    if (fd != expected_fd) {
+        JS_ThrowTypeError(ctx,
+                          "CAPSID_WASI_STDIO_DENIED: fd adoption is forbidden");
+        return false;
+    }
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    if (!qrt || !qrt->capsid_stdio.check) {
+        JS_ThrowTypeError(ctx,
+                          "CAPSID_WASI_STDIO_DENIED: policy unavailable");
+        return false;
+    }
+    char reason[TJS_EGRESS_REASON_MAX] = { 0 };
+    if (!qrt->capsid_stdio.check(qrt->capsid_stdio.opaque, stream,
+                                 reason, sizeof(reason))) {
+        JS_ThrowTypeError(ctx, "CAPSID_WASI_STDIO_DENIED: %s",
+                          reason[0] ? reason : "access denied");
+        return false;
+    }
+    *handle = fd;
+    return true;
+}
+#endif
