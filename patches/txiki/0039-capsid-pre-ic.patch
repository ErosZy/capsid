+#ifdef CONFIG_PRE_IC
+static void js_pre_ic_free(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    JSPreICData *data = b->pre_ic;
+    uint32_t i;
+
+    if (data == NULL)
+        return;
+    for (i = 0; i < data->site_count; i++) {
+        if (data->slots[i].shape != NULL)
+            js_free_shape(rt, data->slots[i].shape);
+        JS_FreeAtomRT(rt, data->slots[i].atom);
+    }
+    assert(rt->pre_ic_bytes >= data->alloc_size);
+    rt->pre_ic_bytes -= data->alloc_size;
+    rt->pre_ic_budget_full = false;
+    js_free_rt(rt, data);
+    b->pre_ic = NULL;
+}
+#endif
