+#ifdef CONFIG_PRE_IC
+static inline void js_pre_ic_install(JSContext *ctx, JSPreICSlot *slot,
+                                     JSShape *shape, uint32_t prop_offset)
+{
+    if (slot->shape == NULL && shape->is_hashed && shape->prop_count <= 64) {
+        slot->prop_offset = prop_offset;
+        slot->shape = js_dup_shape(shape);
+        ctx->rt->pre_ic_installs++;
+    }
+}
+
+#define JS_PRE_IC_RUNTIME_BUDGET (256 * 1024)
+
+/* Quicken only a site that actually executes. The atom ownership moves from
+   the ordinary bytecode operand into the sidecar slot before the operand is
+   replaced by its direct slot index. */
+static void js_pre_ic_quicken_site(JSContext *ctx, JSFunctionBytecode *b,
+                                   uint8_t *insn, JSAtom atom)
+{
+    JSRuntime *rt = ctx->rt;
+    JSPreICSlot *slots;
+    uint32_t site_index;
+
+    if (rt->pre_ic_free_slot != 0) {
+        site_index = rt->pre_ic_free_slot - 1;
+        slots = rt->pre_ic_slots;
+        rt->pre_ic_free_slot = slots[site_index].next_free;
+    } else {
+        if (unlikely(rt->pre_ic_budget_full))
+            return;
+        if (rt->pre_ic_slot_count == rt->pre_ic_slot_capacity) {
+            JSPreICSlot *new_slots;
+            uint32_t old_capacity = rt->pre_ic_slot_capacity;
+            uint32_t new_capacity = old_capacity == 0 ? 1 : old_capacity * 2;
+            size_t old_size = (size_t)old_capacity * sizeof(*new_slots);
+            size_t alloc_size;
+
+            if (unlikely(new_capacity <= old_capacity))
+                goto budget_denied;
+            alloc_size = (size_t)new_capacity * sizeof(*new_slots);
+            if (unlikely(alloc_size / sizeof(*new_slots) != new_capacity ||
+                         alloc_size > JS_PRE_IC_RUNTIME_BUDGET))
+                goto budget_denied;
+            new_slots = js_realloc_rt(rt, rt->pre_ic_slots, alloc_size);
+            if (unlikely(new_slots == NULL))
+                return;
+            memset((uint8_t *)new_slots + old_size, 0,
+                   alloc_size - old_size);
+            rt->pre_ic_slots = new_slots;
+            rt->pre_ic_slot_capacity = new_capacity;
+            rt->pre_ic_bytes = alloc_size;
+        }
+        site_index = rt->pre_ic_slot_count++;
+        slots = rt->pre_ic_slots;
+    }
+
+    slots[site_index].shape = NULL;
+    slots[site_index].atom = atom;
+    slots[site_index].prop_offset = 0;
+    slots[site_index].next_free = 0;
+    rt->pre_ic_active_slots++;
+    if (!b->has_pre_ic) {
+        b->has_pre_ic = true;
+        rt->pre_ic_prepared_functions++;
+    }
+    insn[0] = OP_get_field_preic;
+    put_u32(insn + 1, site_index);
+    rt->pre_ic_selected_sites++;
+    return;
+
+ budget_denied:
+    rt->pre_ic_budget_denials++;
+    rt->pre_ic_budget_full = true;
+}
