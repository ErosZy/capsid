+#ifdef CONFIG_PRE_IC
+static void js_pre_ic_mark(JSRuntime *rt, JSFunctionBytecode *b,
+                           JS_MarkFunc *mark_func)
+{
+    int pos = 0;
+
+    while (pos < b->byte_code_len) {
+        int op = b->byte_code_buf[pos];
+        if (op == OP_get_field_preic) {
+            uint32_t slot_index = get_u32(b->byte_code_buf + pos + 1);
+            JSPreICSlot *slot;
+            assert(slot_index < rt->pre_ic_slot_count);
+            slot = &rt->pre_ic_slots[slot_index];
+            assert(slot->atom != JS_ATOM_NULL);
+            if (slot->shape != NULL)
+                mark_func(rt, &slot->shape->header);
+        }
+        pos += short_opcode_info(op).size;
+    }
+}
+
+static void js_pre_ic_free(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    int pos = 0;
+
+    if (!b->has_pre_ic)
+        return;
+    while (pos < b->byte_code_len) {
+        int op = b->byte_code_buf[pos];
+        if (op == OP_get_field_preic) {
+            uint32_t slot_index = get_u32(b->byte_code_buf + pos + 1);
+            JSPreICSlot *slot;
+            assert(slot_index < rt->pre_ic_slot_count);
+            slot = &rt->pre_ic_slots[slot_index];
+            assert(slot->atom != JS_ATOM_NULL);
+            if (slot->shape != NULL)
+                js_free_shape(rt, slot->shape);
+            b->byte_code_buf[pos] = OP_get_field;
+            put_u32(b->byte_code_buf + pos + 1, slot->atom);
+            slot->shape = NULL;
+            slot->atom = JS_ATOM_NULL;
+            slot->next_free = rt->pre_ic_free_slot;
+            rt->pre_ic_free_slot = slot_index + 1;
+            assert(rt->pre_ic_active_slots > 0);
+            rt->pre_ic_active_slots--;
+        }
+        pos += short_opcode_info(op).size;
+    }
+    b->has_pre_ic = false;
+    rt->pre_ic_budget_full = false;
+    if (rt->pre_ic_active_slots == 0) {
+        js_free_rt(rt, rt->pre_ic_slots);
+        rt->pre_ic_slots = NULL;
+        rt->pre_ic_bytes = 0;
+        rt->pre_ic_slot_count = 0;
+        rt->pre_ic_slot_capacity = 0;
+        rt->pre_ic_free_slot = 0;
+    }
+}
+#endif
