+#ifdef CONFIG_PRE_IC
+static no_inline __attribute__((cold))
+void js_pre_ic_mark(JSRuntime *rt, JSFunctionBytecode *b,
+                    JS_MarkFunc *mark_func)
+{
+    JSPreICState *data = rt->pre_ic;
+    int pos = 0;
+
+    assert(data != NULL);
+    while (pos < b->byte_code_len) {
+        int op = b->byte_code_buf[pos];
+        if (op == OP_get_field_preic) {
+            uint32_t slot_index = get_u32(b->byte_code_buf + pos + 1);
+            JSPreICSlot *slot;
+            assert(slot_index < data->site_count);
+            slot = &data->slots[slot_index];
+            assert(slot->atom != JS_ATOM_NULL);
+            if (slot->shape != NULL)
+                mark_func(rt, &slot->shape->header);
+        }
+        pos += short_opcode_info(op).size;
+    }
+}
+
+static no_inline __attribute__((cold))
+void js_pre_ic_free(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    JSPreICState *data;
+    int pos = 0;
+
+    if (!b->has_pre_ic)
+        return;
+    data = rt->pre_ic;
+    assert(data != NULL);
+    while (pos < b->byte_code_len) {
+        int op = b->byte_code_buf[pos];
+        if (op == OP_get_field_preic) {
+            uint32_t slot_index = get_u32(b->byte_code_buf + pos + 1);
+            JSPreICSlot *slot;
+            assert(slot_index < data->site_count);
+            slot = &data->slots[slot_index];
+            assert(slot->atom != JS_ATOM_NULL);
+            if (slot->shape != NULL)
+                js_free_shape(rt, slot->shape);
+            b->byte_code_buf[pos] = OP_get_field;
+            put_u32(b->byte_code_buf + pos + 1, slot->atom);
+            slot->shape = NULL;
+            slot->atom = JS_ATOM_NULL;
+            slot->next_free = data->free_site;
+            data->free_site = slot_index + 1;
+            assert(data->active_sites > 0);
+            data->active_sites--;
+        }
+        pos += short_opcode_info(op).size;
+    }
+    b->has_pre_ic = false;
+    data->budget_full = false;
+    if (data->active_sites == 0) {
+        js_free_rt(rt, data);
+        rt->pre_ic = NULL;
+    }
+}
+#endif
