+#ifdef CONFIG_PRE_IC
+static inline void js_pre_ic_install(JSContext *ctx, JSPreICSlot *slot,
+                                     JSShape *shape, uint32_t prop_offset)
+{
+    if (slot->shape == NULL && shape->is_hashed && shape->prop_count <= 64) {
+        slot->prop_offset = prop_offset;
+        slot->shape = js_dup_shape(shape);
+        ctx->rt->pre_ic_installs++;
+    }
+}
+
+#define JS_PRE_IC_RUNTIME_BUDGET (256 * 1024)
+
+/* Quicken only a site that actually executes. The atom ownership moves from
+   the ordinary bytecode operand into the sidecar slot before the operand is
+   replaced by its direct slot index. */
+static void js_pre_ic_quicken_site(JSContext *ctx, JSFunctionBytecode *b,
+                                   uint8_t *insn, JSAtom atom)
+{
+    JSRuntime *rt = ctx->rt;
+    JSPreICData *data = b->pre_ic;
+    uint32_t site_index;
+
+    if (unlikely(rt->pre_ic_budget_full))
+        return;
+    if (data == NULL || data->site_count == data->site_capacity) {
+        JSPreICData *new_data;
+        uint32_t new_capacity = data == NULL ? 1 : data->site_capacity * 2;
+        size_t slots_size, alloc_size, old_size = 0;
+
+        if (unlikely(new_capacity == 0 ||
+                     (data != NULL &&
+                      new_capacity <= data->site_capacity)))
+            goto budget_denied;
+        slots_size = (size_t)new_capacity * sizeof(data->slots[0]);
+        if (unlikely(slots_size / sizeof(data->slots[0]) != new_capacity ||
+                     slots_size > SIZE_MAX - sizeof(*data)))
+            goto budget_denied;
+        alloc_size = sizeof(*data) + slots_size;
+        if (data != NULL)
+            old_size = data->alloc_size;
+        if (unlikely(alloc_size - old_size > JS_PRE_IC_RUNTIME_BUDGET ||
+                     rt->pre_ic_bytes > JS_PRE_IC_RUNTIME_BUDGET -
+                                            (alloc_size - old_size)))
+            goto budget_denied;
+        new_data = js_realloc_rt(rt, data, alloc_size);
+        if (unlikely(new_data == NULL))
+            return;
+        memset((uint8_t *)new_data + old_size, 0, alloc_size - old_size);
+        new_data->alloc_size = alloc_size;
+        new_data->site_capacity = new_capacity;
+        if (data == NULL) {
+            new_data->site_count = 0;
+            rt->pre_ic_prepared_functions++;
+        }
+        b->pre_ic = data = new_data;
+        rt->pre_ic_bytes += alloc_size - old_size;
+    }
+
+    site_index = data->site_count++;
+    data->slots[site_index].atom = atom;
+    insn[0] = OP_get_field_preic;
+    put_u32(insn + 1, site_index);
+    rt->pre_ic_selected_sites++;
+    return;
+
+ budget_denied:
+    rt->pre_ic_budget_denials++;
+    rt->pre_ic_budget_full = true;
+}
+#endif
