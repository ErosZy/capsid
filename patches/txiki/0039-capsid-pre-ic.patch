+static inline void js_pre_ic_install(JSContext *ctx, JSPreICSlot *slot,
+                                     JSShape *shape, uint32_t prop_offset)
+{
+    if (slot->shape == NULL && shape->is_hashed && shape->prop_count <= 64) {
+        slot->prop_offset = prop_offset;
+        slot->shape = js_dup_shape(shape);
+        ctx->rt->pre_ic->installs++;
+    }
+}
+
+#define JS_PRE_IC_RUNTIME_BUDGET (256 * 1024)
+
+/* Quicken only a site that actually executes. The atom ownership moves from
+   the ordinary bytecode operand into the sidecar slot before the operand is
+   replaced by its direct slot index. */
+static no_inline __attribute__((cold))
+void js_pre_ic_quicken_site(JSContext *ctx, JSFunctionBytecode *b,
+                            uint8_t *insn, JSAtom atom)
+{
+    JSRuntime *rt = ctx->rt;
+    JSPreICState *data = rt->pre_ic;
+    JSPreICSlot *slots;
+    uint32_t site_index;
+
+    if (data != NULL && data->free_site != 0) {
+        site_index = data->free_site - 1;
+        slots = data->slots;
+        data->free_site = slots[site_index].next_free;
+    } else {
+        if (data != NULL && unlikely(data->budget_full))
+            return;
+        if (data == NULL || data->site_count == data->site_capacity) {
+            JSPreICState *new_data;
+            uint32_t old_capacity = data == NULL ? 0 : data->site_capacity;
+            uint32_t new_capacity = old_capacity == 0 ? 1 : old_capacity * 2;
+            size_t old_size = data == NULL ? 0 : data->alloc_size;
+            size_t header_size = offsetof(JSPreICState, slots);
+            size_t slots_size, alloc_size;
+
+            if (unlikely(new_capacity <= old_capacity))
+                goto budget_denied;
+            slots_size = (size_t)new_capacity * sizeof(data->slots[0]);
+            if (unlikely(slots_size / sizeof(data->slots[0]) != new_capacity ||
+                         slots_size > SIZE_MAX - header_size))
+                goto budget_denied;
+            alloc_size = header_size + slots_size;
+            if (unlikely(alloc_size < old_size ||
+                         alloc_size > JS_PRE_IC_RUNTIME_BUDGET))
+                goto budget_denied;
+            new_data = js_realloc_rt(rt, data, alloc_size);
+            if (unlikely(new_data == NULL))
+                return;
+            memset((uint8_t *)new_data + old_size, 0,
+                   alloc_size - old_size);
+            new_data->alloc_size = alloc_size;
+            new_data->site_capacity = new_capacity;
+            rt->pre_ic = data = new_data;
+        }
+        site_index = data->site_count++;
+        slots = data->slots;
+    }
+
+    slots[site_index].shape = NULL;
+    slots[site_index].atom = atom;
+    slots[site_index].prop_offset = 0;
+    slots[site_index].next_free = 0;
+    data->active_sites++;
+    if (!b->has_pre_ic) {
+        b->has_pre_ic = true;
+        data->prepared_functions++;
+    }
+    insn[0] = OP_get_field_preic;
+    put_u32(insn + 1, site_index);
+    data->selected_sites++;
+    return;
+
+ budget_denied:
+    assert(data != NULL);
+    data->budget_denials++;
+    data->budget_full = true;
+}
+
+static no_inline __attribute__((cold))
+JSValue js_pre_ic_get_field_miss(JSContext *ctx, JSStackFrame *sf,
+                                 JSFunctionBytecode *b, uint8_t *pc,
+                                 JSValueConst obj, JSPreICSlot *slot)
+{
+    JSObject *p;
+    JSProperty *pr;
+    JSShapeProperty *prs;
+
+    if (JS_VALUE_GET_TAG(obj) == JS_TAG_OBJECT) {
+        p = JS_VALUE_GET_OBJ(obj);
+        if (!p->is_exotic) {
+            prs = find_own_property(&pr, p, slot->atom);
+            if (prs && !(prs->flags & JS_PROP_TMASK)) {
+                if (slot->shape == NULL)
+                    js_pre_ic_install(ctx, slot, p->shape,
+                                      prs - p->shape->prop);
+                PROFILE_PROP_SITE(ctx, b, pc - 5, OP_get_field, 0);
+                PROFILE_SHAPE_SITE(ctx, b, pc - 5, OP_get_field, p->shape);
+                return js_dup(pr->u.value);
+            }
+        }
+    }
+    PROFILE_PROP_SITE(ctx, b, pc - 5, OP_get_field, 3);
+    sf->cur_pc = pc;
+    return JS_GetPropertyInternal(ctx, obj, slot->atom, obj, false);
+}
