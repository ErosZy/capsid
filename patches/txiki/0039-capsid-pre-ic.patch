+#ifdef CONFIG_PRE_IC
+#define JS_PRE_IC_RUNTIME_BUDGET (256 * 1024)
+
+static void js_pre_ic_prepare(JSContext *ctx, JSFunctionBytecode *b)
+{
+    JSRuntime *rt = ctx->rt;
+    JSPreICData *data;
+    uint32_t site_count = 0, site_index = 0;
+    int pos, pos_next, op;
+    size_t alloc_size, slots_size;
+
+    if (b->pre_ic != NULL || b->byte_code_len <= 0)
+        return;
+
+    /* Every static field access gets a deterministic, PC-ordered slot. */
+    for (pos = 0; pos < b->byte_code_len; pos = pos_next) {
+        const JSOpCode *oi;
+        op = b->byte_code_buf[pos];
+        if (unlikely(op >= OP_COUNT))
+            return;
+        oi = &short_opcode_info(op);
+        if (unlikely(oi->size == 0 || pos > b->byte_code_len - oi->size))
+            return;
+        pos_next = pos + oi->size;
+        if (op == OP_get_field)
+            site_count++;
+    }
+    if (site_count == 0)
+        return;
+    slots_size = (size_t)site_count * sizeof(data->slots[0]);
+    if (slots_size / sizeof(data->slots[0]) != site_count ||
+        slots_size > SIZE_MAX - sizeof(*data)) {
+        rt->pre_ic_budget_denials++;
+        return;
+    }
+
+    alloc_size = sizeof(*data) + slots_size;
+    if (alloc_size > JS_PRE_IC_RUNTIME_BUDGET ||
+        rt->pre_ic_bytes > JS_PRE_IC_RUNTIME_BUDGET - alloc_size) {
+        rt->pre_ic_budget_denials++;
+        return;
+    }
+    data = js_mallocz_rt(rt, alloc_size);
+    if (data == NULL)
+        return;
+    data->alloc_size = alloc_size;
+    data->site_count = site_count;
+    for (pos = 0; pos < b->byte_code_len; pos = pos_next) {
+        const JSOpCode *oi;
+        uint8_t *insn = b->byte_code_buf + pos;
+        op = insn[0];
+        oi = &short_opcode_info(op);
+        pos_next = pos + oi->size;
+        if (op != OP_get_field)
+            continue;
+        data->slots[site_index].atom = get_u32(insn + 1);
+        insn[0] = OP_get_field_preic;
+        put_u32(insn + 1, site_index++);
+    }
+    assert(site_index == site_count);
+    b->pre_ic = data;
+    rt->pre_ic_bytes += alloc_size;
+    rt->pre_ic_prepared_functions++;
+    rt->pre_ic_selected_sites += site_count;
+}
+
+static void js_pre_ic_free(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    JSPreICData *data = b->pre_ic;
+    uint32_t i;
+
+    if (data == NULL)
+        return;
+    for (i = 0; i < data->site_count; i++) {
+        if (data->slots[i].shape != NULL)
+            js_free_shape(rt, data->slots[i].shape);
+        JS_FreeAtomRT(rt, data->slots[i].atom);
+    }
+    assert(rt->pre_ic_bytes >= data->alloc_size);
+    rt->pre_ic_bytes -= data->alloc_size;
+    js_free_rt(rt, data);
+    b->pre_ic = NULL;
+}
+#endif
