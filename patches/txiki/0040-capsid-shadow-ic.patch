+/* ---------------------------------------------------------------------
+   S1 §5.2/§5.2.1 SHADOW IC: bounded lazy sidecars and state counters.
+   State machine per site (function lifetime):
+
+       COLD -> TRAINING -> MONO -> POLY2 -> MEGAMORPHIC
+                           \----------------> DISABLED
+
+   Rules: at most two shape variants per site; a third distinct shape
+   or eight consecutive misses becomes megamorphic for that function
+   lifetime; OOM or an invalid invariant disables the site and
+   preserves semantics. SHADOW only trains and reports would-hit/miss —
+   the generic result is always used and the site never serves.
+
+   Site ids are derived from the original PC ((pc - byte_code_buf) >> 2
+   & 7); the canonical payload-carried bounded site id lands with R0+
+   emission. Collisions are possible and accepted; the S1 test corpus
+   controls source layout so the locality microcases stay separated.
+
+   MONO hit behavior is read-only: compare the ID32 id, load the
+   adjacent offset, access the property — no counter increment, LRU/ring
+   write, modulo, allocation, refcount, or GC operation. In SHADOW mode
+   the per-site counters below are the entire point of the build; the
+   serving modes (S2) keep the hit path counter-free.
+   ------------------------------------------------------------------- */
+
+static inline uint32_t js_ic_site_id(JSFunctionBytecode *b, const uint8_t *pc)
+{
+    return ((uint32_t)(pc - b->byte_code_buf) >> 2) & (JSIC_MAX_SITES - 1);
+}
+
+static no_inline JSICFunctionState *js_ic_function_state_new(JSRuntime *rt)
+{
+    /* 64-byte align the contiguous sites[] slab (two full cache lines
+       for the 8 entries) by overallocating; mem_base retains the
+       unaligned base for the free. */
+    size_t size = sizeof(JSICFunctionState) + 63;
+    uint8_t *mem = js_malloc_rt(rt, size);
+    JSICFunctionState *fs;
+
+    if (!mem)
+        return NULL;
+    fs = (JSICFunctionState *)(((uintptr_t)mem + 63) & ~(uintptr_t)63);
+    memset(fs, 0, sizeof(*fs));
+    fs->mem_base = mem;
+    fs->alloc_bytes = size;
+    return fs;
+}
+
+/* Unlink and free one function state; a post-teardown call (free_all
+   already freed every state, then JS_RunGC frees bytecodes that call
+   back here) is a no-op: the state is gone from the list, so the free
+   must not run again. */
+static void js_ic_function_state_free(JSRuntime *rt, JSICFunctionState *fs)
+{
+    JSICFunctionState **pp;
+
+    for (pp = &rt->ic_function_states; *pp && *pp != fs; pp = &(*pp)->next)
+        ;
+    if (!*pp)
+        return;
+    *pp = fs->next;
+    rt->ic_budget_bytes += fs->alloc_bytes;
+    js_free_rt(rt, fs->mem_base);
+}
+
+static void js_ic_function_state_free_all(JSRuntime *rt)
+{
+    while (rt->ic_function_states)
+        js_ic_function_state_free(rt, rt->ic_function_states);
+}
+
+/* Lazy sidecar fetch: cold functions allocate neither the site slab nor
+   the cold counters. Budget exhaustion or OOM denies the function for
+   its lifetime (per spec: disables the site and preserves semantics). */
+static no_inline JSICFunctionState *js_ic_function_state(JSContext *ctx,
+                                                         JSFunctionBytecode *b)
+{
+    JSRuntime *rt = ctx->rt;
+    JSICFunctionState *fs;
+
+    if (b->ic_denied)
+        return NULL;
+    fs = b->ic_state;
+    if (fs)
+        return fs;
+    if (rt->ic_budget_bytes < sizeof(JSICFunctionState) + 63) {
+        rt->ic_budget_failures++;
+        b->ic_denied = 1;
+        return NULL;
+    }
+    fs = js_ic_function_state_new(rt);
+    if (!fs) {
+        rt->ic_budget_failures++;
+        b->ic_denied = 1;
+        return NULL;
+    }
+    rt->ic_budget_bytes -= fs->alloc_bytes;
+    fs->next = rt->ic_function_states;
+    rt->ic_function_states = fs;
+    b->ic_state = fs;
+    return fs;
+}
+
+/* One observation of a property access at a site. `cacheable` is the
+   proven own-data (or fast-array element) case the cache could serve;
+   `prop_offset` is the property index / int element index. The site may
+   be updated only when the access proved the cacheable case. */
+static no_inline void js_ic_observe(JSContext *ctx, JSFunctionBytecode *b,
+                                    const uint8_t *pc, JSObject *obj,
+                                    int cacheable, uint32_t prop_offset)
+{
+    JSRuntime *rt = ctx->rt;
+    JSICFunctionState *fs;
+    JSICMonoEntry *e;
+    JSICPolyVariant *pv;
+    uint32_t sid, guard_id;
+
+    if (rt->ic_mode != JS_IC_MODE_SHADOW)
+        return;
+    fs = b->ic_state;
+    if (!fs) {
+        fs = js_ic_function_state(ctx, b);
+        if (!fs)
+            return;
+    }
+    sid = js_ic_site_id(b, pc);
+    e = &fs->sites[sid];
+    pv = &fs->poly[sid];
+    fs->observations++;
+    guard_id = 0;
+    if (obj) {
+        /* ID32 invariant: a zero/unassigned id cannot be guarded (the
+           counter wrap permanently disables identity checking). A
+           non-object access never carries an id and can never disable
+           the site — it is a plain miss. */
+        guard_id = obj->shape->shape_id;
+        if (rt->shape_id_disabled || guard_id == 0) {
+            if (e->state != JSIC_SITE_DISABLED) {
+                e->state = JSIC_SITE_DISABLED;
+                e->flags = 0;
+                fs->disabled++;
+            }
+            return;
+        }
+    }
+    switch (e->state) {
+    case JSIC_SITE_COLD:
+        if (!cacheable) {
+            fs->site_misses[sid]++;
+            if (++e->miss_streak >= JSIC_MAX_CONSEQ_MISSES) {
+                e->state = JSIC_SITE_MEGAMORPHIC;
+                fs->megamorphic++;
+            }
+            return;
+        }
+        /* first proven cacheable access trains the guard */
+        e->guard = guard_id;
+        e->prop_offset = prop_offset;
+        e->flags = JSIC_MONO_HAS_GUARD;
+        e->miss_streak = 1;   /* first hit of the training streak */
+        e->state = JSIC_SITE_TRAINING;
+        fs->site_trains[sid]++;
+        fs->site_hits[sid]++;
+        return;
+
+    case JSIC_SITE_TRAINING:
+    case JSIC_SITE_MONO:
+        if (cacheable && guard_id == (uint32_t)e->guard) {
+            fs->site_hits[sid]++;
+            if (e->state == JSIC_SITE_TRAINING) {
+                if (++e->miss_streak >= JSIC_TRAIN_HITS) {
+                    e->state = JSIC_SITE_MONO;
+                    e->miss_streak = 0;
+                    fs->transitions++;
+                }
+            } else {
+                e->miss_streak = 0;
+            }
+            return;
+        }
+        goto ic_miss;
+
+    case JSIC_SITE_POLY2:
+        /* check the overflow variant first; never rotates on hit */
+        if (cacheable && guard_id == (uint32_t)pv->guard) {
+            fs->site_hits[sid]++;
+            e->miss_streak = 0;
+            return;
+        }
+        if (cacheable && guard_id == (uint32_t)e->guard) {
+            fs->site_hits[sid]++;
+            e->miss_streak = 0;
+            return;
+        }
+        goto ic_miss;
+
+    default: /* MEGAMORPHIC: would-miss for the function lifetime */
+        if (e->state == JSIC_SITE_MEGAMORPHIC)
+            fs->site_misses[sid]++;
+        return;
+    }
+
+ic_miss:
+    fs->site_misses[sid]++;
+    if (e->state == JSIC_SITE_TRAINING)
+        e->miss_streak = 0;   /* the hit streak becomes a miss streak */
+    if (++e->miss_streak >= JSIC_MAX_CONSEQ_MISSES) {
+        e->state = JSIC_SITE_MEGAMORPHIC;
+        fs->megamorphic++;
+        return;
+    }
+    if (!cacheable)
+        return;               /* nothing to train from a non-cacheable access */
+    if (!(e->flags & JSIC_MONO_HAS_POLY)) {
+        /* second distinct shape: train the one overflow variant */
+        pv->guard = guard_id;
+        pv->prop_offset = prop_offset;
+        e->flags |= JSIC_MONO_HAS_POLY;
+        e->state = JSIC_SITE_POLY2;
+        fs->transitions++;
+        return;
+    }
+    /* a third distinct shape makes the site megamorphic */
+    e->state = JSIC_SITE_MEGAMORPHIC;
+    fs->megamorphic++;
+}
+
+/* The exact cacheable predicate of js_get_fast_array_element (the R0
+   fast-array cache target), as a boolean — tag/class/bounds, no shape
+   identity required. */
+static bool js_ic_array_el_cacheable(JSObject *p, uint32_t idx)
+{
+    switch (p->class_id) {
+    case JS_CLASS_ARRAY:
+    case JS_CLASS_ARGUMENTS:
+    case JS_CLASS_MAPPED_ARGUMENTS:
+    case JS_CLASS_INT8_ARRAY:
+    case JS_CLASS_UINT8C_ARRAY:
+    case JS_CLASS_UINT8_ARRAY:
+    case JS_CLASS_INT16_ARRAY:
+    case JS_CLASS_UINT16_ARRAY:
+    case JS_CLASS_INT32_ARRAY:
+    case JS_CLASS_UINT32_ARRAY:
+    case JS_CLASS_BIG_INT64_ARRAY:
+    case JS_CLASS_BIG_UINT64_ARRAY:
+    case JS_CLASS_FLOAT16_ARRAY:
+    case JS_CLASS_FLOAT32_ARRAY:
+    case JS_CLASS_FLOAT64_ARRAY:
+        return idx < p->u.array.count;
+    default:
+        return false;
+    }
+}
+
+/* get_array_el observation: would the fast-array path serve this
+   access? The array shape is the guard; the bounds live in the
+   cacheable flag, so a same-shape out-of-bounds access is a miss. */
+static no_inline void js_ic_observe_array_el(JSContext *ctx,
+                                             JSFunctionBytecode *b,
+                                             const uint8_t *pc,
+                                             JSValue objv, JSValue idxv)
+{
+    JSObject *p;
+    uint32_t idx;
+
+    if (JS_VALUE_GET_TAG(objv) == JS_TAG_OBJECT &&
+        JS_VALUE_GET_TAG(idxv) == JS_TAG_INT) {
+        p = JS_VALUE_GET_OBJ(objv);
+        idx = JS_VALUE_GET_INT(idxv);
+        if (js_ic_array_el_cacheable(p, idx)) {
+            js_ic_observe(ctx, b, pc, p, 1, idx);
+            return;
+        }
+    }
+    js_ic_observe(ctx, b, pc, NULL, 0, 0);
+}
+
+/* S1 observation hooks: no-ops outside the measurement build (zero
+   tax); SHADOW never serves, the generic result is always used. `pc`
+   is the instruction start (ext payloads pass pc - size + 1). */
+
+void JS_ICSetMode(JSRuntime *rt, JSICMode mode)
+{
+    rt->ic_mode = mode;
+}
+
+JSICMode JS_ICGetMode(JSRuntime *rt)
+{
+    return (JSICMode)rt->ic_mode;
+}
+
+void JS_ICGetShadowReport(JSRuntime *rt, JSICShadowReport *out)
+{
+    JSICFunctionState *fs;
+    int i;
+
+    memset(out, 0, sizeof(*out));
+    out->entry_size = sizeof(JSICMonoEntry);
+    out->sites_per_function = JSIC_MAX_SITES;
+    for (fs = rt->ic_function_states; fs; fs = fs->next) {
+        out->functions++;
+        out->bytes += fs->alloc_bytes;
+        out->observations += fs->observations;
+        out->transitions += fs->transitions;
+        out->megamorphic += fs->megamorphic;
+        out->disabled += fs->disabled;
+        for (i = 0; i < JSIC_MAX_SITES; i++) {
+            if (fs->sites[i].state > out->sites[i].state)
+                out->sites[i].state = fs->sites[i].state;
+            out->sites[i].hits += fs->site_hits[i];
+            out->sites[i].misses += fs->site_misses[i];
+            out->sites[i].trains += fs->site_trains[i];
+            out->hits += fs->site_hits[i];
+            out->misses += fs->site_misses[i];
+            out->trains += fs->site_trains[i];
+        }
+    }
+    out->budget_failures = rt->ic_budget_failures;
+}
+
+/* Mirror of JS_DumpOpcodeProfile: the SHADOW teardown report. */
+void JS_DumpICShadowReport(FILE *fp, JSRuntime *rt)
+{
+    JSICShadowReport rep;
+    int i;
+
+    JS_ICGetShadowReport(rt, &rep);
+    fprintf(fp,
+            "{\"ic_mode\":%d,\"entry_size\":%u,\"sites_per_function\":%u,"
+            "\"functions\":%u,\"bytes\":%llu,\"observations\":%llu,"
+            "\"hits\":%llu,\"misses\":%llu,\"trains\":%llu,"
+            "\"transitions\":%llu,\"megamorphic\":%llu,\"disabled\":%llu,"
+            "\"budget_failures\":%llu,\"sites\":[",
+            (int)rt->ic_mode, rep.entry_size, rep.sites_per_function,
+            rep.functions, (unsigned long long)rep.bytes,
+            (unsigned long long)rep.observations,
+            (unsigned long long)rep.hits, (unsigned long long)rep.misses,
+            (unsigned long long)rep.trains,
+            (unsigned long long)rep.transitions,
+            (unsigned long long)rep.megamorphic,
+            (unsigned long long)rep.disabled,
+            (unsigned long long)rep.budget_failures);
+    for (i = 0; i < JSIC_MAX_SITES; i++) {
+        fprintf(fp, "%s{\"state\":%u,\"hits\":%llu,\"misses\":%llu,"
+                "\"trains\":%u}", i ? "," : "", rep.sites[i].state,
+                (unsigned long long)rep.sites[i].hits,
+                (unsigned long long)rep.sites[i].misses,
+                rep.sites[i].trains);
+    }
+    fprintf(fp, "]}\n");
+}
