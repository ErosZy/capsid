Subject: [PATCH] Keep aggregate value temporaries out of recursive bytecode frames

Retain original constructors, ownership and exception checks at each site.
Pointer operands are read once before the original operation; only private
interpreter call conventions change. Public APIs and stack limits are unchanged.

diff --git a/deps/quickjs/quickjs.c b/deps/quickjs/quickjs.c
--- a/deps/quickjs/quickjs.c
+++ b/deps/quickjs/quickjs.c
@@ -17836,6 +17836,49 @@
                                    argc, argv, flags);
 }
 
+/* Keep aggregate call results out of the recursive interpreter frame.
+   MSVC /Od gives each returned JSValue a distinct temporary slot. These
+   output helpers retain the original constructors and reference counts;
+   optimized compilers can inline them back to the original assignment. */
+static inline void js_bytecode_dup_to(JSValue *out, JSValueConst * value)
+{
+    *out = js_dup(*value);
+}
+
+static inline void js_bytecode_int32_to(JSValue *out, int32_t value)
+{
+    *out = js_int32(value);
+}
+
+static inline void js_bytecode_bool_to(JSValue *out, bool value)
+{
+    *out = js_bool(value);
+}
+
+static inline void js_bytecode_float64_to(JSValue *out, double value)
+{
+    *out = js_float64(value);
+}
+
+
+/* MSVC also reserves a separate aggregate argument slot at each /Od call.
+   Read the original operand once, before the original operation. In
+   particular, do not read the operand storage after a finalizer can run. */
+static inline void js_bytecode_free_value(JSContext *ctx, JSValueConst *value)
+{
+    JS_FreeValue(ctx, *value);
+}
+
+static inline void js_bytecode_free_value_rt(JSRuntime *rt, JSValueConst *value)
+{
+    JS_FreeValueRT(rt, *value);
+}
+
+static inline bool js_bytecode_is_exception(JSValueConst *value)
+{
+    return JS_IsException(*value);
+}
