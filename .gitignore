# Local agent, editor, and analysis state.
/.agents/
/.codex/
/.claude/
/.cache/
/.vscode/
/.idea/
.DS_Store

# CMake, CTest, and local build trees.
/build/
/build-*/
/Testing/
**/Testing/
/compile_commands.json

# Reinstallable language dependencies and caches.
**/node_modules/
**/__pycache__/
*.py[cod]
/.pytest_cache/
/.coverage

# Patch/editor leftovers.
*.bak
*.orig
*.rej
*~

# Crash dumps (sanitizer builds write core files).
/core
/core.*

# Benchmark runs are local by default. Keep only reviewed authoritative and
# decision-supporting revisions.
/bench/bin/
/bench/results/*
!/bench/results/README.md
!/bench/results/external-compare-modern-r39-20260730/
!/bench/results/external-compare-modern-r39-20260730/**
