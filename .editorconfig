root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{js,mjs,cjs,ts,tsx,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{vendor,patches,licenses}/**]
insert_final_newline = unset
end_of_line = unset
charset = unset

[{tests,tools,docs/evidence,docs/history/archives,bench/results,perf-site/archives}/**]
insert_final_newline = unset
end_of_line = unset
charset = unset
