# Maintained code uses LF on every platform, regardless of core.autocrlf.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Existing/generated/captured data is not an automatic normalization target.
/vendor/** -text
/licenses/** -text
/docs/** -text
/perf-site/** -text
/bench/results/** -text
/tests/wpt/** -text

# Patch payload whitespace is semantic and is covered by application/audit
# tests rather than Git's generic whitespace checker. The stack is also
# forced to LF: GNU patch treats CR as content, so a CRLF checkout of the
# patches fails hunks against an LF vendor tree (the GitHub runner state).
/patches/txiki/*.patch text eol=lf -whitespace

# The release installer is uploaded verbatim to GitHub Releases; keep it LF
# so Unix shells can consume it directly.
/install.sh text eol=lf

# Reference captures bind exact module bytes, including the original mix of
# LF and CRLF. Disable checkout normalization without rewriting fixture blobs.
/tests/fixtures/*.mjs -text
/tests/fixtures/workerd-ws/*.mjs -text

# Independent models and primary captures compare raw bytes, including the
# original line endings. Their generators, JSON captures, stream bundle and
# upstream patch/license must survive checkout without core.autocrlf changes.
/tests/fixtures/** -text
/tools/*.mjs -text
/tools/*.py -text
/tools/*.json -text
/js/*.js -text
/patches/web-streams/*.patch -text
/licenses/web-streams-polyfill/LICENSE -text

# Captured evidence and byte-preserved qualification archives bind raw SHA256.
# Keep every dated artifact's bytes intact on native Windows checkouts.
/docs/evidence/** -text
/docs/history/archives/** -text
/docs/data/performance-review.json -text
/docs/data/performance-source-manifest.json -text

# Packed transports are exact binary bytes, including split parts whose first
# block may otherwise look textual to Git. Disable diff/merge/EOL conversion.
/perf-site/archives/** binary

# Retained benchmark CSV files use the csv module's RFC-style CRLF records.
/bench/results/**/*.csv -whitespace

