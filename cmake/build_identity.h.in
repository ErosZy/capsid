#ifndef CAPSID_BUILD_IDENTITY_H
#define CAPSID_BUILD_IDENTITY_H

/* Generated by cmake/ComputeBuildIdentity.cmake from the locked manifest
   (docs/txiki-upgrade-baseline.json) and the current CMake configuration.
   This header is the single source of the bytecode-compatibility identity
   and the build provenance: capsid_runtime, capsid-worker and
   capsid-bytecode-compile all consume these macros instead of computing
   the identity themselves. Do not edit. */

#define CAPSID_BUILD_RUNTIME_VERSION "@CAPSID_IDENTITY_RUNTIME_VERSION@"
#define CAPSID_BUILD_ABI_VERSION @CAPSID_IDENTITY_ABI_VERSION@u
#define CAPSID_BUILD_FETCHRPC_VERSION @CAPSID_IDENTITY_FETCHRPC_VERSION@u
#define CAPSID_BUILD_QUICKJS_COMMIT "@CAPSID_IDENTITY_QUICKJS_COMMIT@"
#define CAPSID_BUILD_TXIKI_OVERLAY_KEY "@CAPSID_IDENTITY_OVERLAY_KEY@"
#define CAPSID_BUILD_TXIKI_OVERLAY_MANIFEST "@CAPSID_IDENTITY_OVERLAY_MANIFEST@"
#define CAPSID_BUILD_BYTECODE_COMPILE_FLAGS "@CAPSID_IDENTITY_COMPILE_FLAGS@"
#define CAPSID_BUILD_TARGET_ARCHITECTURE "@CAPSID_IDENTITY_ARCHITECTURE@"
#define CAPSID_BUILD_ENDIANNESS "@CAPSID_IDENTITY_ENDIANNESS@"
#define CAPSID_BUILD_POINTER_WIDTH_BITS @CAPSID_IDENTITY_POINTER_WIDTH@u
#define CAPSID_BUILD_BYTECODE_FORMAT_IDENTITY "@CAPSID_IDENTITY_BYTECODE_FORMAT@"
#define CAPSID_BUILD_CAPABILITY_MANIFEST_SHA256 \
    "@CAPSID_IDENTITY_CAPABILITY_MANIFEST_SHA256@"
#define CAPSID_BUILD_COMPATIBILITY_ID "@CAPSID_IDENTITY_COMPATIBILITY_ID@"

/* WP-07, spec §11.3: build provenance. CAPSID_BUILD_PROVENANCE_DIRTY is 1
   whenever release packaging must reject this build: the configure was not
   a clean Release at a resolvable Capsid git commit. CAPSID_BUILD_BUILD_ID
   is "sha256:" plus 64 lowercase hex — the SHA-256 of the provenance
   record (generated/build-provenance-record.txt) minus its final buildId
   line. */
#define CAPSID_BUILD_CAPSID_COMMIT "@CAPSID_IDENTITY_CAPSID_COMMIT@"
#define CAPSID_BUILD_TREE_CLEAN @CAPSID_IDENTITY_TREE_CLEAN@
#define CAPSID_BUILD_PROVENANCE_DIRTY @CAPSID_IDENTITY_PROVENANCE_DIRTY@
#define CAPSID_BUILD_COMPILER_ID "@CAPSID_IDENTITY_COMPILER_ID@"
#define CAPSID_BUILD_COMPILER_VERSION "@CAPSID_IDENTITY_COMPILER_VERSION@"
#define CAPSID_BUILD_TARGET_TRIPLE "@CAPSID_IDENTITY_TARGET_TRIPLE@"
#define CAPSID_BUILD_TYPE "@CAPSID_IDENTITY_BUILD_TYPE@"
#define CAPSID_BUILD_FEATURE_FLAGS "@CAPSID_IDENTITY_FEATURE_FLAGS@"
#define CAPSID_BUILD_BUILD_ID "@CAPSID_IDENTITY_BUILD_ID@"

#endif
