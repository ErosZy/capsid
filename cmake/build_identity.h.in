#define CAPSID_BUILD_BYTECODE_COMPILE_FLAGS "@CAPSID_IDENTITY_COMPILE_FLAGS@"
#define CAPSID_BUILD_TARGET_ARCHITECTURE "@CAPSID_IDENTITY_ARCHITECTURE@"
#define CAPSID_BUILD_ENDIANNESS "@CAPSID_IDENTITY_ENDIANNESS@"
#define CAPSID_BUILD_POINTER_WIDTH_BITS @CAPSID_IDENTITY_POINTER_WIDTH@u
#define CAPSID_BUILD_BYTECODE_FORMAT_IDENTITY "@CAPSID_IDENTITY_BYTECODE_FORMAT@"
#define CAPSID_BUILD_CAPABILITY_MANIFEST_SHA256 \
