foreach(_required IN ITEMS CAPSID_PREFIX_MODULE CAPSID_PREFIX_TEST_ROOT
        CAPSID_PREFIX_C_COMPILER CAPSID_PREFIX_CXX_COMPILER CAPSID_PREFIX_NINJA)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "${_required} is required")
    endif()
endforeach()

# Keep each execution's compiler logs and products, including the deliberately
# stale negative control. Migration reuses only its own broken-prefix fixture;
# no existing user build directory is removed or reused.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _run)
set(_run_dir "${CAPSID_PREFIX_TEST_ROOT}/${_run}")
file(MAKE_DIRECTORY "${_run_dir}")
function(_capsid_prefix_run _log)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE _result
        OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING NONE)
    file(WRITE "${_case_dir}/${_log}.log" "${_stdout}${_stderr}")
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "${_log} failed (${_result}); see ${_case_dir}/${_log}.log")
    endif()
endfunction()

set(_project [=[
cmake_minimum_required(VERSION 3.18)
project(capsid_prefix_probe LANGUAGES C CXX)
set(CMAKE_C_CL_SHOWINCLUDES_PREFIX "capsid-invalid-dependency-prefix ")
set(CMAKE_CXX_CL_SHOWINCLUDES_PREFIX "capsid-invalid-dependency-prefix ")
set(CMAKE_CL_SHOWINCLUDES_PREFIX "capsid-invalid-dependency-prefix ")
if(CAPSID_PREFIX_FIX)
    include("${CAPSID_PREFIX_MODULE}")
endif()
add_executable(prefix-c main.c)
set_property(TARGET prefix-c PROPERTY C_STANDARD 11)
add_executable(prefix-cxx main.cc)
set_property(TARGET prefix-cxx PROPERTY CXX_STANDARD 11)
]=])

foreach(_case IN ITEMS OFF ON MIGRATE)
    set(_fix OFF)
    if(_case STREQUAL "ON")
        set(_fix ON)
    endif()
    set(_case_dir "${_run_dir}/${_case}")
    set(_source "${_case_dir}/source")
    set(_build "${_case_dir}/build")
    file(MAKE_DIRECTORY "${_source}")
    file(WRITE "${_source}/CMakeLists.txt" "${_project}")
    file(WRITE "${_source}/value.h" "#define CAPSID_PREFIX_VALUE 17\n")
    file(WRITE "${_source}/main.c"
        "#include <stdio.h>\n#include \"value.h\"\nint main(void) {printf(\"%d\\n\", CAPSID_PREFIX_VALUE); return 0;}\n")
    file(WRITE "${_source}/main.cc"
        "#include <cstdio>\n#include \"value.h\"\nint main() {std::printf(\"%d\\n\", CAPSID_PREFIX_VALUE); return 0;}\n")
    _capsid_prefix_run(configure "${CMAKE_COMMAND}" -S "${_source}" -B "${_build}" -G Ninja
        "-DCMAKE_MAKE_PROGRAM=${CAPSID_PREFIX_NINJA}"
        "-DCMAKE_C_COMPILER=${CAPSID_PREFIX_C_COMPILER}"
        "-DCMAKE_CXX_COMPILER=${CAPSID_PREFIX_CXX_COMPILER}"
        "-DCAPSID_PREFIX_MODULE=${CAPSID_PREFIX_MODULE}" "-DCAPSID_PREFIX_FIX=${_fix}")
    _capsid_prefix_run(build-before "${CMAKE_COMMAND}" --build "${_build}" --parallel 2)
    foreach(_name IN ITEMS prefix-c prefix-cxx)
        execute_process(COMMAND "${_build}/${_name}.exe" OUTPUT_VARIABLE _value RESULT_VARIABLE _result)
        string(STRIP "${_value}" _value)
        if(NOT _result EQUAL 0 OR NOT _value STREQUAL "17")
            message(FATAL_ERROR "${_case}/${_name} initial product did not print 17")
        endif()
        file(SHA256 "${_build}/${_name}.exe" _before_${_name})
    endforeach()
    file(SHA256 "${_source}/main.c" _c_before)
    file(SHA256 "${_source}/main.cc" _cxx_before)
    file(WRITE "${_source}/value.h" "#define CAPSID_PREFIX_VALUE 29\n")
    _capsid_prefix_run(build-after "${CMAKE_COMMAND}" --build "${_build}" --parallel 2)
    file(SHA256 "${_source}/main.c" _c_after)
    file(SHA256 "${_source}/main.cc" _cxx_after)
    if(NOT _c_before STREQUAL _c_after OR NOT _cxx_before STREQUAL _cxx_after)
        message(FATAL_ERROR "The regression must change only the header")
    endif()
    foreach(_name IN ITEMS prefix-c prefix-cxx)
        execute_process(COMMAND "${_build}/${_name}.exe" OUTPUT_VARIABLE _value RESULT_VARIABLE _result)
        string(STRIP "${_value}" _value)
        file(SHA256 "${_build}/${_name}.exe" _after)
        if(_fix)
            if(NOT _result EQUAL 0 OR NOT _value STREQUAL "29" OR _before_${_name} STREQUAL _after)
                message(FATAL_ERROR "${_name}: corrected dependencies did not rebuild after a header-only change")
            endif()
        elseif(NOT _result EQUAL 0 OR NOT _value STREQUAL "17" OR NOT _before_${_name} STREQUAL _after)
            message(FATAL_ERROR "${_name}: the broken-prefix negative control did not retain its stale product")
        endif()
    endforeach()
    if(_case STREQUAL "MIGRATE")
        _capsid_prefix_run(dependencies-before "${CAPSID_PREFIX_NINJA}" -C "${_build}" -t deps)
        file(READ "${_case_dir}/dependencies-before.log" _deps)
        foreach(_name IN ITEMS prefix-c prefix-cxx)
            if(NOT _deps MATCHES "${_name}[.]dir/[^\r\n]+[.]obj: #deps 0,")
                message(FATAL_ERROR "${_name}: migration needs an existing zero-dependency object")
            endif()
        endforeach()
        _capsid_prefix_run(configure-migrate "${CMAKE_COMMAND}" -S "${_source}" -B "${_build}"
            -DCAPSID_PREFIX_FIX=ON)
        foreach(_object IN ITEMS CMakeFiles/prefix-c.dir/main.c.obj CMakeFiles/prefix-cxx.dir/main.cc.obj)
            if(EXISTS "${_build}/${_object}")
                message(FATAL_ERROR "Migration retained the stale object: ${_object}")
            endif()
        endforeach()
        _capsid_prefix_run(build-migrated "${CMAKE_COMMAND}" --build "${_build}" --parallel 2)
        _capsid_prefix_run(dependencies-migrated "${CAPSID_PREFIX_NINJA}" -C "${_build}" -t deps)
        file(READ "${_case_dir}/dependencies-migrated.log" _deps)
        foreach(_name IN ITEMS prefix-c prefix-cxx)
            if(NOT _deps MATCHES "${_name}[.]dir/[^\r\n]+[.]obj: #deps [1-9][0-9]*,")
                message(FATAL_ERROR "${_name}: migrated object has no header dependencies")
            endif()
            execute_process(COMMAND "${_build}/${_name}.exe" OUTPUT_VARIABLE _value RESULT_VARIABLE _result)
            string(STRIP "${_value}" _value)
            if(NOT _result EQUAL 0 OR NOT _value STREQUAL "29")
                message(FATAL_ERROR "${_name}: migration did not replace the stale header value")
            endif()
        endforeach()
        _capsid_prefix_run(configure-idempotent "${CMAKE_COMMAND}" -S "${_source}" -B "${_build}")
        foreach(_object IN ITEMS CMakeFiles/prefix-c.dir/main.c.obj CMakeFiles/prefix-cxx.dir/main.cc.obj)
            if(NOT EXISTS "${_build}/${_object}")
                message(FATAL_ERROR "Repeated configuration invalidated a migrated object: ${_object}")
            endif()
        endforeach()
        file(WRITE "${_source}/value.h" "#define CAPSID_PREFIX_VALUE 41\n")
        _capsid_prefix_run(build-header-after-migration "${CMAKE_COMMAND}" --build "${_build}" --parallel 2)
        foreach(_name IN ITEMS prefix-c prefix-cxx)
            execute_process(COMMAND "${_build}/${_name}.exe" OUTPUT_VARIABLE _value RESULT_VARIABLE _result)
            string(STRIP "${_value}" _value)
            if(NOT _result EQUAL 0 OR NOT _value STREQUAL "41")
                message(FATAL_ERROR "${_name}: migrated dependencies missed a later header-only change")
            endif()
        endforeach()
    endif()
endforeach()
message(STATUS "C and C++ header-only recompilation and existing-cache migration verified against a stale-product negative control: ${_run_dir}")
