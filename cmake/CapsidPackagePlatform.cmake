# Canonical archive/SBOM platform names, based on the target rather than host CPU.
include_guard(GLOBAL)

function(capsid_package_platform system processor libc out_platform out_arch)
    string(TOLOWER "${system}" package_system)
    string(TOLOWER "${processor}" package_arch)
    if(package_arch MATCHES "^(amd64|x64|x86_64)$")
        set(package_arch "x86_64")
    elseif(package_arch MATCHES "^(aarch64|arm64)$")
        set(package_arch "arm64")
    endif()
    if(NOT package_system MATCHES "^[a-z0-9_]+$" OR
            NOT package_arch MATCHES "^[a-z0-9_]+$")
        message(FATAL_ERROR "invalid package target system/architecture")
    endif()
    if(package_system STREQUAL "linux")
        if(NOT package_arch MATCHES "^(x86_64|arm64)$")
            message(FATAL_ERROR "unsupported Linux package architecture: ${processor}")
        endif()
        if(NOT libc MATCHES "^(musl|gnu)$")
            message(FATAL_ERROR "unsupported Linux package libc: ${libc}")
        endif()
        set(package_platform "${package_system}-${libc}-${package_arch}")
    else()
        set(package_platform "${package_system}-${package_arch}")
    endif()
    set(${out_platform} "${package_platform}" PARENT_SCOPE)
    set(${out_arch} "${package_arch}" PARENT_SCOPE)
endfunction()
