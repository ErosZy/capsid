include_guard(GLOBAL)

# Parse only the optional, fixed runtime closure of the native MSVC ASan
# package. This does not allow arbitrary DLLs or search the developer PATH.
function(capsid_read_package_asan_runtime root)
    file(READ "${root}/share/capsid/asan-runtime.json" runtime)
    string(JSON count LENGTH "${runtime}")
    if(NOT count EQUAL 6)
        message(FATAL_ERROR "ASan runtime metadata requires exactly six fields")
    endif()
    string(JSON schema GET "${runtime}" schema)
    string(JSON name GET "${runtime}" file)
    string(JSON compiler GET "${runtime}" compilerId)
    string(JSON version GET "${runtime}" compilerVersion)
    if(NOT schema STREQUAL "capsid-msvc-asan-runtime-v1" OR
            NOT name MATCHES "^clang_rt[.]asan_dynamic-(x86_64|i386|aarch64)[.]dll$" OR
            NOT compiler STREQUAL "MSVC" OR NOT version MATCHES "^[0-9]+([.][0-9]+)+$")
        message(FATAL_ERROR "ASan runtime metadata identity differs")
    endif()
    string(JSON count LENGTH "${runtime}" crtFiles)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "ASan runtime metadata requires the two declared VC runtime DLLs")
    endif()
    string(JSON hash GET "${runtime}" sha256)
    set(names "${name}")
    set(hashes "${hash}")
    set(expected vcruntime140.dll vcruntime140_1.dll)
    foreach(i RANGE 0 1)
        string(JSON fields LENGTH "${runtime}" crtFiles ${i})
        string(JSON crt GET "${runtime}" crtFiles ${i} file)
        string(JSON hash GET "${runtime}" crtFiles ${i} sha256)
        if(NOT fields EQUAL 2 OR NOT crt IN_LIST expected OR crt IN_LIST names)
            message(FATAL_ERROR "ASan runtime metadata has an unexpected or duplicate VC runtime DLL")
        endif()
        list(APPEND names "${crt}")
        list(APPEND hashes "${hash}")
    endforeach()
    set(comment "compiler=${compiler} version=${version}")
    foreach(i RANGE 0 2)
        list(GET names ${i} dll)
        list(GET hashes ${i} hash)
        string(LENGTH "${hash}" length)
        if(NOT length EQUAL 64 OR NOT hash MATCHES "^[0-9a-f]+$" OR
                NOT EXISTS "${root}/bin/${dll}")
            message(FATAL_ERROR "ASan runtime DLL missing or SHA256 malformed: ${dll}")
        endif()
        file(SHA256 "${root}/bin/${dll}" actual)
        if(NOT actual STREQUAL hash)
            message(FATAL_ERROR "ASan runtime DLL checksum differs: ${dll}")
        endif()
        string(APPEND comment " ${dll}=sha256:${hash}")
    endforeach()
    set(CAPSID_PACKAGE_ASAN_RUNTIME "${name}" PARENT_SCOPE)
    set(CAPSID_PACKAGE_RUNTIME_FILES "${names}" PARENT_SCOPE)
    set(CAPSID_PACKAGE_RUNTIME_COMPILER_ID "${compiler}" PARENT_SCOPE)
    set(CAPSID_PACKAGE_RUNTIME_COMPILER_VERSION "${version}" PARENT_SCOPE)
    set(CAPSID_PACKAGE_RUNTIME_COMMENT "${comment}" PARENT_SCOPE)
endfunction()
