@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT WIN32)
    find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CapsidTargets.cmake")

# Consumers copy this file next to their executable or add its directory
# to their runtime search path. It is empty for ordinary distributions.
set(Capsid_ASAN_RUNTIME "")
set(Capsid_RUNTIME_DLLS "")
if(NOT "@CAPSID_ASAN_RUNTIME_NAME@" STREQUAL "")
    set_and_check(Capsid_ASAN_RUNTIME "${PACKAGE_PREFIX_DIR}/bin/@CAPSID_ASAN_RUNTIME_NAME@")
    file(SHA256 "${Capsid_ASAN_RUNTIME}" _capsid_asan_sha256)
    if(NOT _capsid_asan_sha256 STREQUAL "@CAPSID_ASAN_RUNTIME_SHA256@")
        message(FATAL_ERROR "Capsid ASan runtime checksum differs from the packaged toolchain runtime")
    endif()
    unset(_capsid_asan_sha256)
    list(APPEND Capsid_RUNTIME_DLLS "${Capsid_ASAN_RUNTIME}")
    set(_capsid_expected_vcruntime140 "@CAPSID_vcruntime140_SHA256@")
    set(_capsid_expected_vcruntime140_1 "@CAPSID_vcruntime140_1_SHA256@")
    foreach(_capsid_crt IN ITEMS vcruntime140 vcruntime140_1)
        set_and_check(_capsid_crt_file "${PACKAGE_PREFIX_DIR}/bin/${_capsid_crt}.dll")
        file(SHA256 "${_capsid_crt_file}" _capsid_crt_sha256)
        if(NOT _capsid_crt_sha256 STREQUAL _capsid_expected_${_capsid_crt})
            message(FATAL_ERROR "Capsid ${_capsid_crt}.dll checksum differs from the packaged toolchain runtime")
        endif()
        list(APPEND Capsid_RUNTIME_DLLS "${_capsid_crt_file}")
    endforeach()
    unset(_capsid_crt)
    unset(_capsid_crt_file)
    unset(_capsid_crt_sha256)
    unset(_capsid_expected_vcruntime140)
    unset(_capsid_expected_vcruntime140_1)
endif()
check_required_components(Capsid)
