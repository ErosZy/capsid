# Validate the repository's current package metadata contract against the
# extracted files and source inputs. This is not a general SPDX validator or
# proof that the dependency inventory covers every transitive component.
include_guard(GLOBAL)
# Functions capture the policies in effect at definition time. Keep this
# module usable from older script entry points without changing their policy
# scope, and test that calling convention with a real package positive control.
cmake_policy(PUSH)
cmake_policy(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/ComparePackageReproducibility.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ReadPackageAsanRuntime.cmake")

function(capsid_sbom_expect json expected)
    string(JSON actual GET "${json}" ${ARGN})
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "SBOM ${ARGN} differs: expected [${expected}], got [${actual}]")
    endif()
endfunction()

function(capsid_validate_package_metadata root source basename)
    capsid_read_verified_package_manifest("${root}" manifest_names)
    capsid_read_build_info_header("${root}" header)
    foreach(key version commitDate buildId compatibilityId compilerId compilerVersion targetTriple featureFlags)
        set(count 0)
        foreach(line IN LISTS header)
            if(line MATCHES "^${key}=(.+)$")
                set(info_${key} "${CMAKE_MATCH_1}")
                math(EXPR count "${count} + 1")
            endif()
        endforeach()
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "package header requires one nonempty ${key}")
        endif()
    endforeach()

    # Expectations come from source locks, not from the SBOM under test.
    file(READ "${source}/CMakeLists.txt" project)
    string(REGEX MATCH "project\\(capsid_runtime VERSION ([0-9.]+) " match "${project}")
    if(NOT match)
        message(FATAL_ERROR "cannot read Capsid source version")
    endif()
    set(source_version "${CMAKE_MATCH_1}")
    if(NOT info_version STREQUAL source_version)
        message(FATAL_ERROR "package version does not match source version")
    endif()
    file(READ "${source}/docs/txiki-upgrade-baseline.json" lock)
    string(JSON txiki_version GET "${lock}" vendor tag)
    string(JSON quickjs_version GET "${lock}" quickjs commit)
    string(JSON overlay_key GET "${lock}" overlay key)
    string(JSON overlay_manifest GET "${lock}" overlay manifest)
    file(READ "${source}/vendor/txiki.js/deps/libwebsockets/CMakeLists.txt" lws)
    foreach(part MAJOR MINOR PATCH_NUMBER)
        string(REGEX MATCH "set\\(CPACK_PACKAGE_VERSION_${part} \"([0-9]+)\"\\)" match "${lws}")
        if(NOT match)
            message(FATAL_ERROR "cannot read libwebsockets ${part} version")
        endif()
        set(lws_${part} "${CMAKE_MATCH_1}")
    endforeach()
    set(lws_version "${lws_MAJOR}.${lws_MINOR}.${lws_PATCH_NUMBER}")

    file(READ "${root}/share/capsid/SBOM.spdx.json" sbom)
    capsid_sbom_expect("${sbom}" "SPDX-2.3" spdxVersion)
    capsid_sbom_expect("${sbom}" "SPDXRef-DOCUMENT" SPDXID)
    capsid_sbom_expect("${sbom}" "CC0-1.0" dataLicense)
    capsid_sbom_expect("${sbom}" "${basename}-sbom" name)
    capsid_sbom_expect("${sbom}" "https://capsid.dev/sbom/${info_buildId}" documentNamespace)
    capsid_sbom_expect("${sbom}" "${info_commitDate}" creationInfo created)
    string(JSON describes_count LENGTH "${sbom}" documentDescribes)
    if(NOT describes_count EQUAL 1)
        message(FATAL_ERROR "SBOM documentDescribes must contain exactly the Capsid package")
    endif()
    capsid_sbom_expect("${sbom}" "SPDXRef-Package-Capsid" documentDescribes 0)

    set(expected_packages capsid txiki.js quickjs-ng libwebsockets)
    set(expected_ids SPDXRef-Package-Capsid SPDXRef-Package-Txiki
        SPDXRef-Package-QuickJS SPDXRef-Package-LibWebSockets)
    set(expected_versions "${source_version}" "${txiki_version}" "${quickjs_version}" "${lws_version}")
    set(CAPSID_PACKAGE_ASAN_RUNTIME "")
    set(CAPSID_PACKAGE_RUNTIME_FILES)
    if(info_compilerId STREQUAL "MSVC" AND info_targetTriple MATCHES "-Windows$" AND
            info_featureFlags MATCHES "(^| )asan=ON( |$)")
        capsid_read_package_asan_runtime("${root}")
        if(NOT CAPSID_PACKAGE_RUNTIME_COMPILER_ID STREQUAL info_compilerId OR
                NOT CAPSID_PACKAGE_RUNTIME_COMPILER_VERSION STREQUAL info_compilerVersion)
            message(FATAL_ERROR "ASan runtime compiler identity differs from build-info")
        endif()
        list(APPEND expected_packages msvc-runtime)
        list(APPEND expected_ids SPDXRef-Package-MsvcRuntime)
        list(APPEND expected_versions "${info_compilerVersion}")
    elseif(EXISTS "${root}/share/capsid/asan-runtime.json")
        message(FATAL_ERROR "ASan runtime metadata present in a non-MSVC-ASan package")
    endif()
    string(JSON count LENGTH "${sbom}" packages)
    list(LENGTH expected_packages expected_count)
    if(NOT count EQUAL expected_count)
        message(FATAL_ERROR "SBOM package inventory differs from the declared components")
    endif()
    set(seen_packages)
    set(all_ids SPDXRef-DOCUMENT)
    math(EXPR last "${expected_count} - 1")
    foreach(i RANGE 0 ${last})
        string(JSON name GET "${sbom}" packages ${i} name)
        list(FIND expected_packages "${name}" index)
        if(index EQUAL -1 OR name IN_LIST seen_packages)
            message(FATAL_ERROR "SBOM unexpected or duplicate package name: ${name}")
        endif()
        list(GET expected_ids ${index} id)
        list(GET expected_versions ${index} version)
        capsid_sbom_expect("${sbom}" "${id}" packages ${i} SPDXID)
        capsid_sbom_expect("${sbom}" "${version}" packages ${i} versionInfo)
        if(name STREQUAL "capsid")
            capsid_sbom_expect("${sbom}" "${info_commitDate}" packages ${i} builtDate)
            capsid_sbom_expect("${sbom}" "build_id=${info_buildId} compatibility_id=${info_compatibilityId}" packages ${i} comment)
        elseif(name STREQUAL "txiki.js")
            capsid_sbom_expect("${sbom}" "overlay_key=${overlay_key} overlay_manifest=${overlay_manifest}" packages ${i} comment)
        elseif(name STREQUAL "msvc-runtime")
            capsid_sbom_expect("${sbom}" "${CAPSID_PACKAGE_RUNTIME_COMMENT}" packages ${i} comment)
            capsid_sbom_expect("${sbom}" "NOASSERTION" packages ${i} licenseConcluded)
        endif()
        list(APPEND seen_packages "${name}")
        list(APPEND all_ids "${id}")
    endforeach()

    set(expected_relationships
        "SPDXRef-DOCUMENT|DESCRIBES|SPDXRef-Package-Capsid"
        "SPDXRef-Package-Capsid|DEPENDS_ON|SPDXRef-Package-Txiki"
        "SPDXRef-Package-Capsid|DEPENDS_ON|SPDXRef-Package-QuickJS"
        "SPDXRef-Package-Capsid|DEPENDS_ON|SPDXRef-Package-LibWebSockets")
    if(CAPSID_PACKAGE_RUNTIME_FILES)
        list(APPEND expected_relationships
            "SPDXRef-Package-Capsid|DEPENDS_ON|SPDXRef-Package-MsvcRuntime")
    endif()
    string(JSON file_count LENGTH "${sbom}" files)
    list(LENGTH manifest_names manifest_count)
    if(NOT file_count EQUAL manifest_count)
        message(FATAL_ERROR "SBOM file inventory count differs from verified package manifest")
    endif()
    math(EXPR last "${file_count} - 1")
    set(seen_files)
    foreach(i RANGE 0 ${last})
        string(JSON name GET "${sbom}" files ${i} fileName)
        string(REGEX REPLACE "^/" "" relative "${name}")
        if(NOT name STREQUAL "/${relative}" OR NOT relative IN_LIST manifest_names
                OR relative IN_LIST seen_files)
            message(FATAL_ERROR "SBOM unexpected or duplicate file name: ${name}")
        endif()
        string(JSON id GET "${sbom}" files ${i} SPDXID)
        if(NOT id MATCHES "^SPDXRef-File-[0-9]+$" OR id IN_LIST all_ids)
            message(FATAL_ERROR "SBOM invalid or duplicate file SPDXID: ${id}")
        endif()
        string(JSON checksum_count LENGTH "${sbom}" files ${i} checksums)
        if(NOT checksum_count EQUAL 1)
            message(FATAL_ERROR "SBOM file must have exactly one SHA256 checksum: ${name}")
        endif()
        capsid_sbom_expect("${sbom}" "SHA256" files ${i} checksums 0 algorithm)
        file(SHA256 "${root}/${relative}" checksum)
        capsid_sbom_expect("${sbom}" "${checksum}" files ${i} checksums 0 checksumValue)
        string(REGEX REPLACE "^bin/" "" dll "${relative}")
        if(relative STREQUAL "bin/${dll}" AND dll IN_LIST CAPSID_PACKAGE_RUNTIME_FILES)
            capsid_sbom_expect("${sbom}" "NOASSERTION" files ${i} licenseConcluded)
        endif()
        list(APPEND seen_files "${relative}")
        list(APPEND all_ids "${id}")
        list(APPEND expected_relationships "SPDXRef-Package-Capsid|CONTAINS|${id}")
    endforeach()

    string(JSON count LENGTH "${sbom}" relationships)
    list(LENGTH expected_relationships expected_count)
    if(NOT count EQUAL expected_count)
        message(FATAL_ERROR "SBOM relationship inventory count differs")
    endif()
    math(EXPR last "${count} - 1")
    set(relationships)
    foreach(i RANGE 0 ${last})
        string(JSON from GET "${sbom}" relationships ${i} spdxElementId)
        string(JSON type GET "${sbom}" relationships ${i} relationshipType)
        string(JSON to GET "${sbom}" relationships ${i} relatedSpdxElement)
        list(APPEND relationships "${from}|${type}|${to}")
    endforeach()
    list(SORT relationships)
    list(SORT expected_relationships)
    if(NOT relationships STREQUAL expected_relationships)
        message(FATAL_ERROR "SBOM relationship inventory differs")
    endif()
    set(CAPSID_PACKAGE_ASAN_RUNTIME "${CAPSID_PACKAGE_ASAN_RUNTIME}" PARENT_SCOPE)
endfunction()
cmake_policy(POP)
